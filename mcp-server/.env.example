# El runtime no carga este archivo automáticamente.
HOST=127.0.0.1
PORT=4326
ELICITA_API_URL=http://localhost:4321

# Ignorado: experimentales desregistradas incondicionalmente.
MCP_ENABLE_EXPERIMENTAL_TOOLS=false
# OAuth/discovery desactivados: no se requieren variables ni secretos OAuth.
# La API key directa se suministra por petición Bearer, nunca como key compartida.

# Sidecar MCP SDK v2: listener/ruta independientes y allowlists obligatorias.
# No incluir secretos. El proceso se niega a arrancar si faltan las allowlists.
MCP_V2_HOST=127.0.0.1
MCP_V2_PORT=4327
MCP_V2_PATH=/mcp-v2
ELICITA_MCP_V2_ALLOWED_HOSTS=mcp.example.com
ELICITA_MCP_V2_ALLOWED_ORIGINS=app.example.com

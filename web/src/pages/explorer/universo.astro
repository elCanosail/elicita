  let snapshotMode = false;

  // CSV mínimo consciente de comillas (nombres con comas: "JANSSEN CILAG, S.A.")
  function parseCsvText(text: string): string[][] {
    const rows: string[][] = [];
    let row: string[] = [];
    let field = '';
    let inQuotes = false;
    for (let i = 0; i < text.length; i++) {
      const ch = text[i];
      if (inQuotes) {
        if (ch === '"') {
          if (text[i + 1] === '"') { field += '"'; i++; }
          else inQuotes = false;
        } else field += ch;
      } else if (ch === '"') {
        inQuotes = true;
      } else if (ch === ',') {
        row.push(field); field = '';
      } else if (ch === '\n') {
        row.push(field); field = '';
        rows.push(row); row = [];
      } else if (ch !== '\r') {
        field += ch;
      }
    }
    if (field !== '' || row.length > 0) { row.push(field); rows.push(row); }
    return rows;
  }

  async function loadSnapshotGraph(dataset: string) {
    loadingEl.classList.add('visible');
    searchHighlight.clear();
    hoverIdx = -1;
    fadeIn = 0;
    try {
      const [csvRes, snapRes] = await Promise.all([
        fetch(`/data/market-intelligence/${dataset}/latest/edges.csv`),
        fetch(`/data/market-intelligence/${dataset}/latest/snapshot.json`),
      ]);
      if (!csvRes.ok || !snapRes.ok) return;
      const rows = parseCsvText(await csvRes.text());
      if (rows.length < 2) return;
      const idx = (h: string) => rows[0]!.indexOf(h);
      const iBuyerId = idx('buyer_id'), iBuyerName = idx('buyer_name'), iNif = idx('nif'), iCompany = idx('company_name'), iContracts = idx('analytic_contracts'), iAmount = idx('observed_amount_eur');
      const nodeMap = new Map<string, GNode>();
      const edgeMap = new Map<string, GEdge>();
      for (const r of rows.slice(1)) {
        const buyerId = r[iBuyerId] ?? '';
        const nif = r[iNif] ?? '';
        if (!buyerId || !nif) continue;
        const contratos = Number(r[iContracts]) || 0;
        const volumen = Number(r[iAmount]) || 0;
        const orgId = `org:${buyerId}`;
        const adjId = `adj:${nif}`;
        let org = nodeMap.get(orgId);
        if (!org) { org = { id: orgId, name: r[iBuyerName] ?? buyerId, type: 'organismo', contratos: 0, volumen: 0 }; nodeMap.set(orgId, org); }
        org.contratos += contratos; org.volumen += volumen;
        let adj = nodeMap.get(adjId);
        if (!adj) { adj = { id: adjId, name: r[iCompany] ?? nif, type: 'adjudicatario', contratos: 0, volumen: 0 }; nodeMap.set(adjId, adj); }
        adj.contratos += contratos; adj.volumen += volumen;
        const key = `${orgId}|||${adjId}`;
        const pair = edgeMap.get(key);
        if (pair) { pair.contratos += contratos; pair.volumen += volumen; }
        else edgeMap.set(key, { source: orgId, target: adjId, contratos, volumen });
      }
      if (!nodeMap.size) return;
      // Centro: el comprador con más volumen agregado del sector (determinista)
      let center = nodeMap.get('org:' + (rows[1]![iBuyerId] ?? ''))!;
      for (const node of nodeMap.values()) {
        if (node.type === 'organismo' && node.volumen > center.volumen) center = node;
      }
      initGraph({ center, nodes: [...nodeMap.values()], edges: [...edgeMap.values()] });
      snapshotMode = true;
      lastQuery = '';
      lastType = '';
      searchInput.value = '';
      try {
        const snap = await snapRes.json();
        (document.getElementById('snapshot-badge-id') as HTMLElement).textContent = snap.snapshot_id ?? dataset;
      } catch { /* badge sin id */ }
      (document.getElementById('snapshot-badge') as HTMLElement).style.display = 'block';
    } catch (err) {
      console.error('[universo] snapshot load error', err);
    } finally {
      loadingEl.classList.remove('visible');
    }
  }

  function exitSnapshotMode() {

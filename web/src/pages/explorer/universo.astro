  // ── Search autocomplete ───────────────────────────────────────────────────
  let ddResults: Array<{ name: string; id: string; type: string }> = [];
  let ddSel = -1;
  let debounce: ReturnType<typeof setTimeout> | null = null;

  function renderDropdown() {
    if (!ddResults.length) {
      dropdown.innerHTML = '<div class="dd-empty">Sin resultados</div>';
      dropdown.classList.add('visible');
      return;
    }

    const empresas = ddResults.filter(r => r.type === 'adjudicatario');
    const orgs     = ddResults.filter(r => r.type === 'organismo');

    let html = '';
    let idx = 0;

    if (empresas.length) {
      html += '<div class="dd-section">🟢 Empresas</div>';
      for (const r of empresas) {
        const sel = idx === ddSel ? ' sel' : '';
        html += `<div class="dd-item${sel}" data-idx="${idx}" data-id="${esc(r.id)}" data-type="${esc(r.type)}">
          <span class="dd-icon">🏢</span>
          <span class="dd-name">${escHtml(r.name)}</span>
          <span class="dd-type">NIF</span>
        </div>`;
        idx++;
      }
    }
    if (orgs.length) {
      html += '<div class="dd-section">🔵 Organismos</div>';
      for (const r of orgs) {
        const sel = idx === ddSel ? ' sel' : '';
        html += `<div class="dd-item${sel}" data-idx="${idx}" data-id="${esc(r.id)}" data-type="${esc(r.type)}">
          <span class="dd-icon">🏛</span>
          <span class="dd-name">${escHtml(r.name)}</span>
        </div>`;
        idx++;
      }
    }

    dropdown.innerHTML = html;
    dropdown.classList.add('visible');

    dropdown.querySelectorAll('.dd-item').forEach(el => {
      el.addEventListener('mouseenter', () => {
        ddSel = Number((el as HTMLElement).dataset.idx);
        renderDropdown();
      });
      el.addEventListener('pointerdown', (ev) => {
        ev.preventDefault();
        ev.stopPropagation();
        const id   = (el as HTMLElement).dataset.id || '';
        const type = (el as HTMLElement).dataset.type || '';
        selectResult(id, type);
      });
    });
  }

  function esc(s: string) { return s.replace(/"/g, '&quot;'); }
  function escHtml(s: string) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  async function doSearch(q: string) {
    if (q.length < 2) { dropdown.classList.remove('visible'); return; }
    const res = await fetch(`/api/graph-search?q=${encodeURIComponent(q)}`);
    if (res.status === 401) {
      const returnUrl = encodeURIComponent(location.pathname + location.search);
      location.href = '/sign-in?redirect_url=' + returnUrl;
      return;
    }
    if (!res.ok) return;
    ddResults = await res.json();
    ddSel = ddResults.length > 0 ? 0 : -1;
    renderDropdown();
  }

  searchInput.addEventListener('input', () => {
    if (debounce) clearTimeout(debounce);
    debounce = setTimeout(() => doSearch(searchInput.value.trim()), 300);
  });

  searchInput.addEventListener('keydown', (e) => {
    if (!dropdown.classList.contains('visible')) return;
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      ddSel = Math.min(ddSel + 1, ddResults.length - 1);
      renderDropdown();
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      ddSel = Math.max(ddSel - 1, 0);
      renderDropdown();
    } else if (e.key === 'Enter') {
      e.preventDefault();
      const r = ddResults[ddSel >= 0 ? ddSel : 0];
      if (r) selectResult(r.id, r.type);
    } else if (e.key === 'Escape') {
      dropdown.classList.remove('visible');
    }
  });

  document.addEventListener('pointerdown', (e) => {
    if (!searchInput.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
      dropdown.classList.remove('visible');
    }
  });

  async function selectResult(id: string, type: string) {
    dropdown.classList.remove('visible');
    searchInput.blur();
    searchInput.value = id;
    await loadGraph(id, type);
  }

  async function loadGraph(q: string, type: string) {
    loadingEl.classList.add('visible');
    searchHighlight.clear();
    hoverIdx = -1;
    fadeIn = 0;
    lastQuery = q;
    lastType = type;

    const cpvParam = selectedCpv ? `&cpv=${encodeURIComponent(selectedCpv)}` : '';
    const yearParams = getYearParams();
    try {
      const res = await fetch(`/api/graph?q=${encodeURIComponent(q)}&type=${encodeURIComponent(type)}${cpvParam}${yearParams}`);
      if (res.status === 401) {
        const returnUrl = encodeURIComponent(location.pathname + location.search);
        location.href = '/sign-in?redirect_url=' + returnUrl;
        return;
      }
      if (!res.ok) {
        const err = await res.json();
        console.error('[universo] graph error', err);
        return;
      }
      const data = await res.json();
      exitSnapshotMode();
      initGraph(data);
    } catch (err) {
      console.error('[universo] fetch error', err);
    } finally {
      loadingEl.classList.remove('visible');
    }
  }

  function getYearParams(): string {
    const yf = yearFrom.value;
    const yt = yearTo.value;
    let params = '';
    if (yf) params += `&year=${encodeURIComponent(yf)}`;
    if (yt) params += `&year_end=${encodeURIComponent(yt)}`;
    return params;
  }

  function populateYearSelects() {
    const currentYear = new Date().getFullYear();
    for (let y = 2015; y <= currentYear; y++) {
      yearFrom.add(new Option(String(y), String(y)));
      yearTo.add(new Option(String(y), String(y)));
    }
  }
  populateYearSelects();

  function maybeReloadGraph() {
    if (nodes.length > 0 && lastQuery && lastType) {
      loadGraph(lastQuery, lastType);
    }
  }

  yearFrom.addEventListener('change', maybeReloadGraph);
  yearTo.addEventListener('change', maybeReloadGraph);

  // ── Share button ────────────────────────────────────────────────
  const shareBtn = document.getElementById('share-btn') as HTMLButtonElement;
  shareBtn.addEventListener('click', async () => {
    if (!lastQuery || !lastType) return;
    const params = new URLSearchParams();
    params.set('q', lastQuery);
    params.set('type', lastType);
    if (selectedCpv) params.set('cpv', selectedCpv);
    if (yearFrom.value) params.set('year', yearFrom.value);
    if (yearTo.value) params.set('year_end', yearTo.value);
    const shareUrl = `${window.location.origin}/explorer/universo?${params.toString()}`;
    try {
      await navigator.clipboard.writeText(shareUrl);
      shareBtn.textContent = '✓ Enlace copiado';
      shareBtn.classList.add('copied');
      setTimeout(() => { shareBtn.textContent = '🔗'; shareBtn.classList.remove('copied'); }, 2000);
    } catch {
      // Fallback para navegadores sin clipboard API
      const ta = document.createElement('textarea');
      ta.value = shareUrl;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
      shareBtn.textContent = '✓ Enlace copiado';
      shareBtn.classList.add('copied');
      setTimeout(() => { shareBtn.textContent = '🔗'; shareBtn.classList.remove('copied'); }, 2000);
    }
  });

  // ── Load from URL params on init ────────────────────────────────
  (function loadFromUrl() {
    const urlParams = new URLSearchParams(window.location.search);
    const q = urlParams.get('q');
    const type = urlParams.get('type');
    if (q && type) {
      const cpvParam = urlParams.get('cpv');
      const yearParam = urlParams.get('year');
      const yearEndParam = urlParams.get('year_end');
      if (cpvParam) { selectedCpv = cpvParam; sectorSelect.value = cpvParam; updateClearSectorVisibility(); }
      if (yearParam) yearFrom.value = yearParam;
      if (yearEndParam) yearTo.value = yearEndParam;
      searchInput.value = q;
      loadGraph(q, type);
    }
  })();

  // Search highlight (filter nodes matching text)
  searchInput.addEventListener('keyup', () => {
    const q = searchInput.value.toLowerCase().trim();
    searchHighlight.clear();
    if (q.length >= 2 && nodes.length > 0) {
      nodes.forEach((n, i) => {
        if (n.name.toLowerCase().includes(q) || n.id.toLowerCase().includes(q)) {
          searchHighlight.add(i);
        }
      });
      // Pan to first match
      if (searchHighlight.size > 0 && nodes.length > 0) {
        const first = searchHighlight.values().next().value;
        tx = W / 2 - px[first] * scale;
        ty = H / 2 - py[first] * scale;
      }
    }
  });

})();
</script>

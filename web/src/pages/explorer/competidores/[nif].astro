<script is:inline>
(function() {
  const btn = document.getElementById('follow-btn');
  if (!btn) return;

  const type = btn.dataset.type;
  const id = btn.dataset.id;
  const name = btn.dataset.name;
  let isAuth = false;

  function setFollowing(following) {
    const icon = btn.querySelector('.follow-icon');
    const text = btn.querySelector('.follow-text');
    if (following) {
      btn.classList.add('following');
      if (icon) icon.textContent = '★';
      if (text) text.textContent = 'Dejar de seguir';
    } else {
      btn.classList.remove('following');
      if (icon) icon.textContent = '☆';
      if (text) text.textContent = 'Seguir';
    }
  }

  async function load() {
    try {
      const res = await fetch('/api/follows');
      if (res.status === 401) {
        isAuth = false;
        return;
      }
      isAuth = true;
      if (!res.ok) return;
      const data = await res.json();
      const list = type === 'organismo' ? (data.follows?.organismos || []) : (data.follows?.competidores || []);
      const following = list.some(f => f.id === id);
      setFollowing(following);
    } catch (e) {
      console.error('[follows] error loading:', e);
    }
  }

  btn.addEventListener('click', async () => {
    if (!isAuth) {
      window.location.href = '/sign-up';
      return;
    }
    const following = btn.classList.contains('following');
    btn.disabled = true;
    try {
      if (following) {
        const res = await fetch(`/api/follows?type=${encodeURIComponent(type)}&id=${encodeURIComponent(id)}`, { method: 'DELETE' });
        if (res.ok) setFollowing(false);
      } else {
        const res = await fetch('/api/follows', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type, id, nombre: name }),
        });
        if (res.ok) {
          setFollowing(true);
        } else if (res.status === 403) {
          const data = await res.json();
          if (confirm((data.error || 'Límite alcanzado') + ' ¿Ver planes?')) {
            window.location.href = data.upgrade || '/precios';
          }
        }
      }
    } catch (e) {
      console.error('[follows] error toggling:', e);
    } finally {
      btn.disabled = false;
    }
  });

  load();
})();
</script>

<script is:inline>
(function() {
  function fmtV(v) {
    if (v >= 1_000_000) return (v / 1_000_000).toFixed(1) + 'M€';
    if (v >= 1_000) return (v / 1_000).toFixed(0) + 'K€';
    return v.toFixed(0) + '€';
  }

  function renderConflictos(container, data) {
    const nif = container.getAttribute('data-nif');
    if (!data || !data.conflictos || data.conflictos.length === 0) {
      container.innerHTML = '<div class="empty-card">Sin cargos compartidos detectados</div>';
      return;
    }

    // Aggregate by persona + empresa vinculada
    const groups = new Map();
    for (const c of data.conflictos) {
      const key = c.persona_hash + '::' + c.empresa_vinculada;
      let g = groups.get(key);
      if (!g) {
        g = {
          persona_hash: c.persona_hash,
          cargo_origen: c.cargo_origen,
          empresa_vinculada: c.empresa_vinculada,
          nif_vinculada: c.nif_vinculada,
          cargo_vinculada: c.cargo_vinculada,
          organismos: new Map(),
        };
        groups.set(key, g);
      }
      if (!g.organismos.has(c.organismo_comun)) {
        g.organismos.set(c.organismo_comun, {
          organismo: c.organismo_comun,
          contratos_origen: c.contratos_origen,
          volumen_origen: c.volumen_origen,
          contratos_vinculada: c.contratos_vinculada,
          volumen_vinculada: c.volumen_vinculada,
        });
      }
    }

    const rows = Array.from(groups.values()).map(g => {
      const orgs = Array.from(g.organismos.values());
      const totalVolOrigen = orgs.reduce((s, o) => s + (o.volumen_origen || 0), 0);
      const totalVolVinculada = orgs.reduce((s, o) => s + (o.volumen_vinculada || 0), 0);
      const totalContratosOrigen = orgs.reduce((s, o) => s + (o.contratos_origen || 0), 0);
      const totalContratosVinculada = orgs.reduce((s, o) => s + (o.contratos_vinculada || 0), 0);
      const numOrganismos = orgs.length;
      let badgeClass = 'badge-severidad-yellow';
      let badgeText = '🟡 ' + numOrganismos + ' organismo' + (numOrganismos === 1 ? '' : 's');
      if (numOrganismos >= 2 && numOrganismos <= 3) {
        badgeClass = 'badge-severidad-orange';
        badgeText = '🟠 ' + numOrganismos + ' organismos';
      } else if (numOrganismos >= 4) {
        badgeClass = 'badge-severidad-red';
        badgeText = '🔴 ' + numOrganismos + ' organismos';
      }
      return {
        persona_hash: g.persona_hash,
        cargo_origen: g.cargo_origen,
        empresa_vinculada: g.empresa_vinculada,
        nif_vinculada: g.nif_vinculada,
        cargo_vinculada: g.cargo_vinculada,
        organismos: orgs,
        totalContratosOrigen,
        totalContratosVinculada,
        totalVolOrigen,
        totalVolVinculada,
        badgeClass,
        badgeText,
      };
    });

    let html = '<div class="card"><div class="card-header">Cargos directivos compartidos entre empresas</div>';
    if (data.parcial) {
      html += '<div style="font-size:11px;color:hsl(var(--warning));margin-bottom:10px;">⚠️ Respuesta parcial: algunas consultas excedieron el tiempo límite.</div>';
    }
    html += '<div class="org-scroll"><table class="data-table conflictos-table"><thead><tr>';
    html += '<th>Persona</th><th>Empresa vinculada</th><th>Organismos comunes</th>';
    html += '<th class="th-r">Contratos origen</th><th class="th-r">Volumen origen</th>';
    html += '<th class="th-r">Contratos vinc.</th><th class="th-r">Volumen vinc.</th>';
    html += '<th class="th-r">Severidad</th></tr></thead><tbody>';

    for (const r of rows) {
      const personaDisplay = '#' + (r.persona_hash ? r.persona_hash.slice(-8).toUpperCase() : '????');
      const empresaLink = r.nif_vinculada
        ? '<a href="/explorer/competidores/' + encodeURIComponent(r.nif_vinculada) + '" class="org-link">' + r.empresa_vinculada + '</a>'
        : r.empresa_vinculada;
      const organismosPills = r.organismos.map(o =>
        '<span class="conflictos-pill" title="' + o.organismo + '">' + o.organismo.slice(0, 32) + (o.organismo.length > 32 ? '…' : '') + '</span>'
      ).join(' ');
      html += '<tr>';
      html += '<td class="td-persona"><span class="mono">' + personaDisplay + '</span><br><span style="font-size:10px;color:hsl(var(--foreground) / 0.35);">' + (r.cargo_origen || '—') + '</span></td>';
      html += '<td class="td-empresa">' + empresaLink + '<br><span style="font-size:10px;color:hsl(var(--foreground) / 0.35);">' + (r.cargo_vinculada || '—') + '</span></td>';
      html += '<td class="td-org">' + organismosPills + '</td>';
      html += '<td class="td-r mono">' + r.totalContratosOrigen.toLocaleString('es-ES') + '</td>';
      html += '<td class="td-r mono">' + fmtV(r.totalVolOrigen) + '</td>';
      html += '<td class="td-r mono">' + r.totalContratosVinculada.toLocaleString('es-ES') + '</td>';
      html += '<td class="td-r mono">' + fmtV(r.totalVolVinculada) + '</td>';
      html += '<td class="td-r"><span class="badge-severidad ' + r.badgeClass + '">' + r.badgeText + '</span></td>';
      html += '</tr>';
    }

    html += '</tbody></table></div></div>';
    container.innerHTML = html;
  }

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('conflictos-container');
    if (!container) return;
    const nif = container.getAttribute('data-nif');
    if (!nif) {
      container.innerHTML = '<div class="empty-card">Sin cargos compartidos detectados</div>';
      return;
    }
    fetch('/api/conflictos?nif=' + encodeURIComponent(nif))
      .then(res => res.json())
      .then(data => renderConflictos(container, data))
      .catch(err => {
        console.error('[conflictos] error:', err);
        container.innerHTML = '<div class="empty-card">Sin cargos compartidos detectados</div>';
      });

    document.querySelectorAll('.clickable-row[data-href]').forEach(row => {
      row.addEventListener('click', () => {
        const href = row.getAttribute('data-href');
        if (href) window.location.href = href;
      });
    });
  });
})();
</script>


---
import Layout from '../../../layouts/dashboard.astro';
import { query } from '../../../lib/duckdb';
import { titleCase } from '../../../lib/format';


const { nif } = Astro.params;

if (!nif) {
  return Astro.redirect('/explorer/competidores');
}

// CPV dictionary
let cpvDict: Record<string, string> = {};
try {
  const cpvModule = await import('../../../data/cpv_es.json');
  cpvDict = (cpvModule.default || cpvModule) as Record<string, string>;
} catch {}

// ── 1. All contratación queries in parallel ────────────────────────────────
let companyName = nif;
let totalContratos = 0;
let totalVolumen = 0;
let mediaContrato = 0;
let topOrganismos: { organismo: string; contratos: number; volumen: number }[] = [];
let evolucionAnual: { ano: number; contratos: number; volumen: number }[] = [];
let cpvsPrincipales: { code: string; name: string; count: number }[] = [];

interface Adjudicacion {
  id: string;
  objeto: string;
  organismo: string;
  importe: number;
  fecha: string;
  estado: string;
  cpv: string;
}
let adjudicaciones: Adjudicacion[] = [];

try {
  const [nameRows, statsRows, orgRows, anoRows, cpvRows, adjRows] = await Promise.all([
    query(`SELECT DISTINCT adjudicatario FROM contratos_vivos WHERE nif_adjudicatario = ? AND adjudicatario IS NOT NULL LIMIT 1`, [nif]),
    query(`SELECT COUNT(*) AS total, COALESCE(SUM(importe_adjudicacion), 0) AS volumen FROM contratos_vivos WHERE nif_adjudicatario = ?`, [nif]),
    query(`SELECT organismo, COUNT(*) AS contratos, COALESCE(SUM(importe_adjudicacion), 0) AS volumen FROM contratos_vivos WHERE nif_adjudicatario = ? AND organismo IS NOT NULL GROUP BY organismo ORDER BY volumen DESC LIMIT 20`, [nif]),
    query(`SELECT EXTRACT(YEAR FROM fecha_publicacion) AS ano, COUNT(*) AS contratos, COALESCE(SUM(importe_adjudicacion), 0) AS volumen FROM contratos_vivos WHERE nif_adjudicatario = ? AND fecha_publicacion IS NOT NULL GROUP BY ano ORDER BY ano ASC`, [nif]),
    query(`SELECT cpv AS cpv_principal, COUNT(*) AS cnt FROM contratos_vivos WHERE nif_adjudicatario = ? AND cpv IS NOT NULL GROUP BY cpv ORDER BY cnt DESC LIMIT 8`, [nif]),
    query(`SELECT objeto, organismo, importe_adjudicacion, fecha_publicacion, estado, cpv, id FROM contratos_vivos WHERE nif_adjudicatario = ? ORDER BY fecha_publicacion DESC LIMIT 50`, [nif]),
  ]);

  if (nameRows.length > 0) companyName = titleCase(nameRows[0].adjudicatario) || nameRows[0].adjudicatario;
  if (statsRows.length > 0) {
    totalContratos = Number(statsRows[0].total) || 0;
    totalVolumen = Number(statsRows[0].volumen) || 0;
    mediaContrato = totalContratos > 0 ? totalVolumen / totalContratos : 0;
  }
  topOrganismos = orgRows.map(r => ({ organismo: titleCase(r.organismo) || r.organismo, contratos: Number(r.contratos), volumen: Number(r.volumen) }));
  evolucionAnual = anoRows.map(r => ({ ano: Number(r.ano), contratos: Number(r.contratos), volumen: Number(r.volumen) }));
  cpvsPrincipales = cpvRows.map(r => {
    const code = String(r.cpv).replace('.0', '').trim();
    return { code, name: cpvDict[code] || code, count: Number(r.cnt) };
  });
  adjudicaciones = adjRows.map((r: any) => ({
    id: r.id ? String(r.id) : '',
    objeto: r.objeto || '—',
    organismo: titleCase(r.organismo) || r.organismo || '—',
    importe: Number(r.importe_adjudicacion) || 0,
    fecha: r.fecha_publicacion ? String(r.fecha_publicacion).slice(0, 10) : '—',
    estado: r.estado || '—',
    cpv: r.cpv ? String(r.cpv).replace('.0', '').trim() : '',
  }));
} catch (e: any) {
  console.error('[ficha competidor] contratación error:', e?.message);
}

// ── 2. Calidad ────────────────────────────────────────────────────────────
const CALIDAD_INDICATORS = [
  'INT-VAL-01','INT-VAL-02','INT-VAL-03','INT-VAL-04','INT-VAL-05',
  'INT-VAL-06','INT-VAL-07','INT-VAL-09','INT-VAL-10','INT-VAL-12','INT-VAL-14',
  'INT-CONS-01','INT-CONS-08','INT-CONS-18','INT-CONS-20',
  'INT-FIA-01','INT-FIA-04','INT-FIA-08','INT-FIA-09','INT-FIA-11',
];
const INDICATOR_LABELS: Record<string, string> = {
  'INT-VAL-01': 'Publicación en plazo',
  'INT-VAL-02': 'Tipo de procedimiento informado',
  'INT-VAL-03': 'Criterios de adjudicación publicados',
  'INT-VAL-04': 'Plazo de presentación adecuado',
  'INT-VAL-05': 'Objeto del contrato descriptivo',
  'INT-VAL-06': 'CPV informado',
  'INT-VAL-07': 'Valor estimado publicado',
  'INT-VAL-09': 'Nº de ofertas recibidas informado',
  'INT-VAL-10': 'Adjudicatario identificado',
  'INT-VAL-12': 'Importe de adjudicación publicado',
  'INT-VAL-14': 'Fecha de adjudicación informada',
  'INT-CONS-01': 'Coherencia tipo contrato - CPV',
  'INT-CONS-08': 'Coherencia importe licitación - adjudicación',
  'INT-CONS-18': 'Coherencia procedimiento - nº ofertas',
  'INT-CONS-20': 'Coherencia plazos',
  'INT-FIA-01': 'NIF adjudicatario válido',
  'INT-FIA-04': 'Importe adjudicación > 0',
  'INT-FIA-08': 'Adjudicatario no es el propio órgano',
  'INT-FIA-09': 'Duración del contrato informada',
  'INT-FIA-11': 'Condiciones de ejecución informadas',
};

let calidadScore: number | null = null;
let calidadTotal = 0;
let calidadIndicators: Record<string, number | null> = {};

// Normalize company name for BORME lookup
function normalizeName(name: string): string {
  return name.replace(/,/g, '').replace(/\./g, '')
    .replace(/\bS\.?L\.?U\.?\b/gi, '').replace(/\bS\.?A\.?U\.?\b/gi, '')
    .replace(/\bS\.?L\.?\b/gi, '').replace(/\bS\.?A\.?\b/gi, '')
    .replace(/\bS\.?C\.?\b/gi, '').replace(/\bS\.?L\.?P\.?\b/gi, '')
    .toUpperCase().replace(/\s+/g, ' ').trim();
}

// ── NIF canonical resolution ───────────────────────────────────────────────
let canonicalName: string | null = null;
let bormeNorm = '';
let nifVerificado = false;
try {
  const canonRows = await query(`SELECT nombre FROM nif_canonical WHERE nif = ? LIMIT 1`, [nif]);
  if (canonRows.length > 0 && canonRows[0].nombre) {
    canonicalName = String(canonRows[0].nombre);
    nifVerificado = true;
  }
} catch (e: any) {
  console.error('[ficha competidor] nif_canonical error:', e?.message);
}

const bormeSearchName = canonicalName || companyName;
bormeNorm = normalizeName(bormeSearchName);

let bormeEmpresas: { fecha_borme: string; actos: string; domicilio?: string; capital_euros?: number; fecha_constitucion?: string; provincia?: string; hoja_registral?: string; tomo?: string; inscripcion?: string; fecha_inscripcion?: string }[] = [];
let bormeCargos: { fecha_borme: string; tipo_acto: string; cargo: string; persona_hash: string }[] = [];
let bormeInfo: { domicilio?: string; capital_euros?: number; fecha_constitucion?: string; provincia?: string; hoja_registral?: string; tomo?: string; inscripcion?: string; fecha_inscripcion?: string } = {};

// ── Run calidad + BORME queries in parallel ────────────────────────────────
try {
  const indicatorSelects = CALIDAD_INDICATORS.map(ind =>
    `SUM(CASE WHEN "${ind}" THEN 1 ELSE 0 END) * 100.0 / NULLIF(SUM(CASE WHEN "${ind}" IS NOT NULL THEN 1 ELSE 0 END), 0) AS "${ind}_pct"`
  ).join(', ');

  const [calidadResult, bormeEmpResult, bormeCargoResult] = await Promise.all([
    query(`SELECT AVG(score_calidad) AS score, CAST(COUNT(*) AS INTEGER) AS total, ${indicatorSelects} FROM calidad WHERE nif_adjudicatario = ?`, [nif]).catch(() => []),
    query(`SELECT fecha_borme, actos, domicilio, capital_euros, fecha_constitucion FROM borme_empresas WHERE empresa_norm LIKE ? ORDER BY fecha_borme DESC LIMIT 30`, [`%${bormeNorm}%`]).catch(() => []),
    query(`SELECT fecha_borme, tipo_acto, cargo, persona_hash FROM borme_cargos WHERE empresa_norm LIKE ? ORDER BY fecha_borme DESC LIMIT 50`, [`%${bormeNorm}%`]).catch(() => []),
  ]);

  // Process calidad
  if (calidadResult.length > 0 && calidadResult[0].score !== null) {
    calidadScore = Math.round(calidadResult[0].score * 10) / 10;
    calidadTotal = calidadResult[0].total || 0;
    for (const ind of CALIDAD_INDICATORS) {
      const val = calidadResult[0][`${ind}_pct`];
      calidadIndicators[ind] = val !== null && val !== undefined ? Math.round(val) : null;
    }
  }

  // Process BORME empresas
  bormeEmpresas = bormeEmpResult.map((r: any) => ({
    fecha_borme: r.fecha_borme ? String(r.fecha_borme).slice(0, 10) : '—',
    actos: r.actos || '—',
    domicilio: r.domicilio || undefined,
    capital_euros: r.capital_euros ? Number(r.capital_euros) : undefined,
    fecha_constitucion: r.fecha_constitucion ? String(r.fecha_constitucion).slice(0, 10) : undefined,
    provincia: r.provincia || undefined,
    hoja_registral: r.hoja_registral || undefined,
    tomo: r.tomo || undefined,
    inscripcion: r.inscripcion || undefined,
    fecha_inscripcion: r.fecha_inscripcion ? String(r.fecha_inscripcion).slice(0, 10) : undefined,
  }));
  for (const row of bormeEmpResult) {
    if (!bormeInfo.domicilio && row.domicilio) bormeInfo.domicilio = row.domicilio;
    if (!bormeInfo.capital_euros && row.capital_euros) bormeInfo.capital_euros = Number(row.capital_euros);
    if (!bormeInfo.fecha_constitucion && row.fecha_constitucion) bormeInfo.fecha_constitucion = String(row.fecha_constitucion).slice(0, 10);
    if (!bormeInfo.provincia && row.provincia) bormeInfo.provincia = row.provincia;
    if (!bormeInfo.hoja_registral && row.hoja_registral) bormeInfo.hoja_registral = row.hoja_registral;
    if (!bormeInfo.tomo && row.tomo) bormeInfo.tomo = row.tomo;
    if (!bormeInfo.inscripcion && row.inscripcion) bormeInfo.inscripcion = row.inscripcion;
    if (!bormeInfo.fecha_inscripcion && row.fecha_inscripcion) bormeInfo.fecha_inscripcion = String(row.fecha_inscripcion).slice(0, 10);
  }

  // Process BORME cargos
  bormeCargos = bormeCargoResult.map((r: any) => ({
    fecha_borme: r.fecha_borme ? String(r.fecha_borme).slice(0, 10) : '—',
    tipo_acto: r.tipo_acto || '—',
    cargo: r.cargo || '—',
    persona_hash: r.persona_hash || '',

  }));
} catch (e) { console.error("[ficha] calidad+BORME:", e?.message); }

// ── BORME Name Resolution ──────────────────────────────────────────────


// ── 4. HALLAZGOS ──────────────────────────────────────────────────────────
interface Hallazgo {
  nivel: 'info' | 'warning' | 'risk';
  icon: string;
  texto: string;
}
const hallazgos: Hallazgo[] = [];

try {
  // Shared admin: persons in this company's cargos that also appear in other adjudicatarios
  if (bormeCargos.length > 0) {
    const personHashes = [...new Set(bormeCargos.map(c => c.persona_hash).filter(Boolean))];
    if (personHashes.length > 0) {
      const hashLiteral = personHashes.map(h => `'${h.replace(/'/g, "''")}'`).join(',');
      const sharedAdminRows = await query(
        `SELECT COUNT(DISTINCT bc.empresa_norm) AS num_empresas
         FROM borme_cargos bc
         WHERE bc.persona_hash IN (${hashLiteral})
           AND bc.empresa_norm NOT LIKE ?`,
        [`%${bormeNorm}%`]
      );
      const numEmpresas = Number(sharedAdminRows[0]?.num_empresas || 0);
      if (numEmpresas > 1) {
        hallazgos.push({
          nivel: 'info',
          icon: '🔗',
          texto: `Administrador presente en ${numEmpresas} otras empresas registradas en BORME`,
        });
      }
    }
  }

  // Dissolution/bankruptcy risk
  const riskActs = bormeEmpresas.filter(e => {
    const actos = (e.actos || '').toLowerCase();
    return actos.includes('disoluci') || actos.includes('concurso') || actos.includes('liquidaci');
  });
  if (riskActs.length > 0) {
    hallazgos.push({
      nivel: 'risk',
      icon: '⚠️',
      texto: `Señal de riesgo: acto de disolución/concurso registrado (${riskActs[0].fecha_borme})`,
    });
  }

  // Recently constituted
  if (bormeInfo.fecha_constitucion && evolucionAnual.length > 0) {
    const constitucion = new Date(bormeInfo.fecha_constitucion.replace(/(\d{2})\.(\d{2})\.(\d{2,4})/, '$3-$2-$1'));
    const firstAno = evolucionAnual[0].ano;
    const firstAdjDate = new Date(`${firstAno}-01-01`);
    const monthsDiff = (firstAdjDate.getTime() - constitucion.getTime()) / (1000 * 60 * 60 * 24 * 30);
    if (monthsDiff < 24 && monthsDiff >= 0) {
      hallazgos.push({
        nivel: 'warning',
        icon: '🆕',
        texto: `Empresa constituida ${Math.round(monthsDiff)} meses antes de su primera adjudicación (${bormeInfo.fecha_constitucion})`,
      });
    }
  }

  // Low capital, large contracts
  if (bormeInfo.capital_euros !== undefined && bormeInfo.capital_euros < 3000 && totalVolumen > 100000) {
    hallazgos.push({
      nivel: 'warning',
      icon: '💶',
      texto: `Capital social bajo (${bormeInfo.capital_euros.toLocaleString('es-ES')}€) frente a volumen de contratos elevado (${fmtVolumen(totalVolumen)})`,
    });
  }

  // No hallazgos found → positive signal
  if (hallazgos.length === 0 && totalContratos > 0) {
    hallazgos.push({
      nivel: 'info',
      icon: '✅',
      texto: 'Sin señales de riesgo detectadas en el cruce de fuentes disponibles',
    });
  }
} catch (e: any) {
  console.error('[ficha competidor] hallazgos error:', e?.message);
}

// ── Compute active officers (Nombramientos without matching Ceses) ─────────
const nombramientos = bormeCargos.filter(c =>
  c.tipo_acto.toLowerCase().includes('nombramiento')
);
const cesadoKeys = new Set(
  bormeCargos
    .filter(c => c.tipo_acto.toLowerCase().includes('ces') || c.tipo_acto.toLowerCase().includes('dimisi'))
    .map(c => `${c.persona_hash}:${c.cargo}`)
);
const seenActive = new Set<string>();
const activeCargos = nombramientos
  .filter(c => {
    const key = `${c.persona_hash}:${c.cargo}`;
    if (cesadoKeys.has(key)) return false;
    if (seenActive.has(key)) return false;
    seenActive.add(key);
    return true;
  })
  .sort((a, b) => b.fecha_borme.localeCompare(a.fecha_borme));

// ── Close DB ──────────────────────────────────────────────────────────────
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');

// ── Helpers ───────────────────────────────────────────────────────────────
function fmtVolumen(v: number): string {
  if (v >= 1_000_000) return (v / 1_000_000).toFixed(1) + 'M€';
  if (v >= 1_000) return (v / 1_000).toFixed(0) + 'K€';
  return v.toFixed(0) + '€';
}

function scoreColor(s: number | null): string {
  if (s === null) return 'hsl(var(--muted-foreground))';
  if (s > 85) return 'hsl(var(--primary))';
  if (s > 70) return 'hsl(var(--warning))';
  return 'hsl(var(--destructive))';
}

function hallazgoColor(nivel: string): string {
  if (nivel === 'risk') return 'hsl(var(--destructive))';
  if (nivel === 'warning') return 'hsl(var(--warning))';
  return 'hsl(var(--primary))';
}

// Bar chart for yearly evolution
const maxContratos = evolucionAnual.length > 0 ? Math.max(...evolucionAnual.map(r => r.contratos)) : 1;
---

<Layout title={`${companyName} — elicita_`} active="competidores">

<div class="ficha-wrap">

  <!-- Back -->
  <a href="/explorer/competidores" class="back-link">← Volver a Competidores</a>

  <!-- Header -->
  <div class="ficha-header">
    <div class="ficha-header-main">
      <h1 class="ficha-name">{companyName}</h1>
      <div class="ficha-nif">NIF: <span class="mono">{nif}</span>
        {nifVerificado ? (
          <span class="nif-badge nif-badge-verified" title="NIF encontrado en BORME">NIF verificado en BORME</span>
        ) : (
          <span class="nif-badge nif-badge-unverified" title="NIF no presente en BORME">NIF no verificado</span>
        )}
      </div>
      {canonicalName && (
        <div class="ficha-canonical mono">{titleCase(canonicalName)}</div>
      )}
    </div>
    <div class="ficha-actions">
      <button id="follow-btn" class="follow-btn" data-type="competidor" data-id={nif} data-name={companyName}>
        <span class="follow-icon">☆</span>
        <span class="follow-text">Seguir</span>
      </button>
      {calidadScore !== null && (
        <div class="score-badge-lg" style={`color:${scoreColor(calidadScore)};border-color:${scoreColor(calidadScore)}44`}
             title={`Score de calidad basado en ${calidadTotal.toLocaleString('es-ES')} contratos`}>
          <div class="score-val">{calidadScore}</div>
          <div class="score-lbl">calidad</div>
        </div>
      )}
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- CONTRATACIÓN PÚBLICA -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="section-title">
    <span class="section-line"></span>
    <span>CONTRATACIÓN PÚBLICA</span>
    <span class="section-line"></span>
  </div>

  {totalContratos === 0 ? (
    <div class="empty-card">Sin datos de contratación para este NIF</div>
  ) : (
    <>
      <!-- Stats row -->
      <div class="stats-row">
        <div class="stat-card">
          <div class="stat-val mono">{totalContratos.toLocaleString('es-ES')}</div>
          <div class="stat-lbl">Total contratos</div>
        </div>
        <div class="stat-card">
          <div class="stat-val mono">{fmtVolumen(totalVolumen)}</div>
          <div class="stat-lbl">Volumen total</div>
        </div>
        <div class="stat-card">
          <div class="stat-val mono">{fmtVolumen(mediaContrato)}</div>
          <div class="stat-lbl">Media por contrato</div>
        </div>
        <div class="stat-card">
          <div class="stat-val mono">PLACE</div>
          <div class="stat-lbl">Fuente principal</div>
        </div>
      </div>

      <!-- Top organismos -->
      {topOrganismos.length > 0 && (
        <div class="card">
          <div class="card-header">Top Organismos Contratantes (por volumen)</div>
          <div class="org-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Organismo</th>
                <th class="th-r">Contratos</th>
                <th class="th-r">Volumen</th>
              </tr>
            </thead>
            <tbody>
              {topOrganismos.map(org => (
                <tr>
                  <td class="td-org">
                    <a href={`/explorer/organismos/${encodeURIComponent(org.organismo)}`} class="org-link">{org.organismo}</a>
                  </td>
                  <td class="td-r mono">{org.contratos.toLocaleString('es-ES')}</td>
                  <td class="td-r mono">{fmtVolumen(org.volumen)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
        </div>
      )}

      <!-- Evolución anual -->
      {evolucionAnual.length > 0 && (
        <div class="card">
          <div class="card-header">Evolución Anual</div>
          <div class="evo-chart">
            {evolucionAnual.map(row => (
              <div class="evo-row">
                <div class="evo-year mono">{row.ano}</div>
                <div class="evo-bar-wrap">
                  <div class="evo-bar" style={`width:${Math.max(2, (row.contratos / maxContratos) * 100)}%`}></div>
                </div>
                <div class="evo-val mono">{row.contratos} <span class="evo-vol">({fmtVolumen(row.volumen)})</span></div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- CPVs principales -->
      {cpvsPrincipales.length > 0 && (
        <div class="card">
          <div class="card-header">CPVs Principales</div>
          <div class="cpv-pills">
            {cpvsPrincipales.map(cpv => (
              <div class="cpv-pill" title={`${cpv.code} · ${cpv.count} contratos`}>
                <span class="cpv-code mono">{cpv.code}</span>
                <span class="cpv-name">{cpv.name.replace(/\.$/, '').slice(0, 60)}{cpv.name.length > 60 ? '…' : ''}</span>
                <span class="cpv-cnt mono">×{cpv.count}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- ÚLTIMAS ADJUDICACIONES -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  {adjudicaciones.length > 0 && (
    <>
      <div class="section-title">
        <span class="section-line"></span>
        <span>ÚLTIMAS ADJUDICACIONES</span>
        <span class="section-line"></span>
      </div>
      <div class="card">
        <div class="card-header">Últimas Adjudicaciones</div>
        <div class="adj-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Objeto</th>
                <th>Organismo</th>
                <th class="th-r">Importe</th>
                <th class="th-r">Fecha</th>
              </tr>
            </thead>
            <tbody>
              {adjudicaciones.map(a => (
                <tr class={a.id ? 'clickable-row' : ''} data-href={a.id ? `/monitor/licitacion/${a.id}` : undefined}>
                  <td class="td-objeto">
                    <div class="obj-clamp" title={a.objeto}>{a.objeto}</div>
                  </td>
                  <td class="td-org-sm">{a.organismo}</td>
                  <td class="td-r mono">{fmtVolumen(a.importe)}</td>
                  <td class="td-r mono" style="font-size:11px;color:hsl(var(--foreground) / 0.3)">{a.fecha}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- INDICADORES DE CALIDAD -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="section-title">
    <span class="section-line"></span>
    <span>INDICADORES DE CALIDAD</span>
    <span class="section-line"></span>
  </div>

  {calidadScore === null ? (
    <div class="empty-card">Sin datos de calidad para este NIF</div>
  ) : (
    <div class="card">
      <div class="calidad-header">
        <div class="score-badge-md" style={`color:${scoreColor(calidadScore)};border-color:${scoreColor(calidadScore)}44`}>
          <div class="score-val-md">{calidadScore}</div>
          <div class="score-lbl-sm">/ 100</div>
        </div>
        <div class="calidad-meta">
          <div class="calidad-title">Score de Calidad Documental</div>
          <div class="calidad-sub">Basado en {calidadTotal.toLocaleString('es-ES')} contratos analizados</div>
        </div>
      </div>
      <div class="indicators-grid">
        {CALIDAD_INDICATORS.map(ind => {
          const pct = calidadIndicators[ind];
          const label = INDICATOR_LABELS[ind] || ind;
          const color = pct === null ? 'hsl(var(--muted-foreground))' : pct >= 85 ? 'hsl(var(--primary))' : pct >= 70 ? 'hsl(var(--warning))' : 'hsl(var(--destructive))';
          return (
            <div class="indicator-item" title={`${ind}: ${pct !== null ? pct + '%' : 'Sin datos'}`}>
              <div class="ind-bar-wrap">
                <div class="ind-bar" style={`width:${pct ?? 0}%;background:${color}`}></div>
              </div>
              <div class="ind-bottom">
                <span class="ind-code mono">{ind}</span>
                <span class="ind-pct mono" style={`color:${color}`}>{pct !== null ? pct + '%' : '—'}</span>
              </div>
              <div class="ind-label">{label}</div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- REGISTRO MERCANTIL (BORME) — only render when data exists -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  {bormeEmpresas.length === 0 && bormeCargos.length === 0 && totalContratos === 0 && (
    <>
      <div class="section-title">
        <span class="section-line"></span>
        <span>REGISTRO MERCANTIL (BORME)</span>
        <span class="section-line"></span>
      </div>
      <div class="empty-card">Empresa no encontrada en registro mercantil</div>
    </>
  )}

  {(bormeEmpresas.length > 0 || bormeCargos.length > 0) && (
    <>
      <div class="section-title">
        <span class="section-line"></span>
        <span>REGISTRO MERCANTIL (BORME)</span>
        <span class="section-line"></span>
      </div>

      <div class="borme-grid">
        <!-- Company details -->
        {(bormeInfo.domicilio || bormeInfo.capital_euros !== undefined || bormeInfo.fecha_constitucion || bormeInfo.provincia || bormeInfo.tomo) && (
          <div class="card borme-info-card">
            <div class="card-header">Datos Registrales</div>
            <div class="borme-details">
              {bormeInfo.domicilio && (
                <div class="borme-detail-row">
                  <span class="detail-icon">📍</span>
                  <span class="detail-val">{bormeInfo.domicilio}</span>
                </div>
              )}
              {bormeInfo.provincia && (
                <div class="borme-detail-row">
                  <span class="detail-icon">📌</span>
                  <span class="detail-val">{titleCase(bormeInfo.provincia)}</span>
                </div>
              )}
              {bormeInfo.capital_euros !== undefined && (
                <div class="borme-detail-row">
                  <span class="detail-icon">💶</span>
                  <span class="detail-val">Capital social: <span class="mono">{bormeInfo.capital_euros.toLocaleString('es-ES')}€</span></span>
                </div>
              )}
              {bormeInfo.fecha_constitucion && (
                <div class="borme-detail-row">
                  <span class="detail-icon">📅</span>
                  <span class="detail-val">Constitución: <span class="mono">{bormeInfo.fecha_constitucion}</span></span>
                </div>
              )}
              {bormeInfo.tomo && (
                <div class="borme-detail-row">
                  <span class="detail-icon">📖</span>
                  <span class="detail-val">Tomo <span class="mono">{bormeInfo.tomo}</span>{bormeInfo.hoja_registral && ` · Hoja ${bormeInfo.hoja_registral}`}{bormeInfo.inscripcion && ` · Inscripción ${bormeInfo.inscripcion}`}</span>
                </div>
              )}
              {bormeInfo.fecha_inscripcion && (
                <div class="borme-detail-row">
                  <span class="detail-icon">📝</span>
                  <span class="detail-val">Fecha de inscripción: <span class="mono">{bormeInfo.fecha_inscripcion}</span></span>
                </div>
              )}
            </div>
          </div>
        )}

        <!-- Active officers -->
        {activeCargos.length > 0 && (
          <div class="card">
            <div class="card-header">Administradores Activos</div>
            <div class="cargos-list">
              {activeCargos.slice(0, 15).map(c => (
                <div class="cargo-row">
                  <div class="cargo-left">
                    <span class="cargo-badge">{c.cargo}</span>
                    <span class="cargo-name hash">
                      Persona #{c.persona_hash ? c.persona_hash.slice(-4).toUpperCase() : '????'}
                    </span>
                  </div>
                  <span class="cargo-fecha mono">{c.fecha_borme}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- All cargos (historical) if no active computed but cargos exist -->
        {activeCargos.length === 0 && bormeCargos.length > 0 && (
          <div class="card">
            <div class="card-header">Cargos y Representantes</div>
            <div class="cargos-list">
              {[...new Map(bormeCargos.map(c => [c.persona_hash + c.cargo, c])).values()].slice(0, 15).map(c => (
                <div class="cargo-row">
                  <div class="cargo-left">
                    <span class="cargo-badge">{c.cargo}</span>
                    <span class="cargo-acto">{c.tipo_acto}</span>
                  </div>
                  <span class="cargo-fecha mono">{c.fecha_borme}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Timeline actos -->
        {bormeEmpresas.length > 0 && (
          <div class="card borme-timeline-card">
            <div class="card-header">Actos Mercantiles</div>
            <div class="timeline">
              {bormeEmpresas.slice(0, 20).map(e => (
                <div class="timeline-item">
                  <div class="timeline-dot"></div>
                  <div class="timeline-content">
                    <div class="timeline-date mono">{e.fecha_borme}</div>
                    <div class="timeline-actos">{e.actos}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </>
  )}

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- CARGOS COMPARTIDOS -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="section-title">
    <span class="section-line"></span>
    <span>CARGOS COMPARTIDOS</span>
    <span class="section-line"></span>
  </div>

  <div id="conflictos-container" data-nif={nif}>
    <div class="empty-card">Cargando análisis de cargos compartidos...</div>
  </div>
  <div class="text-xs text-white/40 mt-2 max-w-2xl">
    Información derivada del cruce de datos públicos (BORME + contratación). La coincidencia de cargos entre empresas no implica irregularidad. Análisis estadístico, no juicio legal.
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- HALLAZGOS -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <div class="section-title">
    <span class="section-line"></span>
    <span>HALLAZGOS</span>
    <span class="section-line"></span>
  </div>

  <div class="hallazgos-list">
    {hallazgos.map(h => (
      <div class="hallazgo-card" style={`border-left-color:${hallazgoColor(h.nivel)}`}>
        <span class="hallazgo-icon">{h.icon}</span>
        <span class="hallazgo-texto">{h.texto}</span>
      </div>
    ))}
    {hallazgos.length === 0 && (
      <div class="empty-card">Sin hallazgos disponibles</div>
    )}
  </div>

  <div class="ficha-footer">
    <span class="mono">Fuentes: PLACSP + CCAA unificadas (contratos_vivos) · BORME · calidad</span>
    <span>·</span>
    <span>NIF: <span class="mono">{nif}</span></span>
  </div>

</div>

</Layout>


---
import Layout from '../layouts/main.astro';
---

<Layout title="Solicitar acceso — elicita_">
	<section class="py-20 md:py-32 min-h-screen">
		<div class="container mx-auto px-6">
			<div class="max-w-3xl mx-auto">
				
				<!-- Header -->
				<div class="mb-12">
					<p class="font-mono text-emerald-400 text-xs tracking-widest uppercase mb-4">Acceso</p>
					<h1 class="text-3xl md:text-4xl text-white font-light mb-4">
						Perfil preliminar de cliente
					</h1>
					<p class="text-white/40 text-sm leading-relaxed max-w-lg">
						Cuéntanos qué buscas y te diremos si elicita te sirve — y cómo.
					</p>
				</div>

				<!-- Form Perfil Completo -->
				<div class="border border-white/10 bg-black/40 rounded-lg p-8">
					<form id="form-perfil" class="space-y-8">
					<input type="hidden" name="_tipo" value="perfil" />
						
						<!-- Sección: Contacto -->
						<div class="space-y-5">
							<div class="font-mono text-[10px] text-emerald-400 uppercase tracking-widest">01 / Contacto</div>
							
							<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
								<div>
									<label class="block text-white/40 text-xs mb-2 font-mono">nombre</label>
									<input
										type="text"
										name="nombre"
										class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20"
										placeholder="Nombre completo"
										required
									/>
								</div>
								<div>
									<label class="block text-white/40 text-xs mb-2 font-mono">email</label>
									<input
										type="email"
										name="email"
										class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20"
										placeholder="email@empresa.com"
										required
									/>
								</div>
							</div>

							<div>
								<label class="block text-white/40 text-xs mb-2 font-mono">empresa</label>
								<input
									type="text"
									name="empresa"
									class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20"
									placeholder="Razón social"
									required
								/>
							</div>
						</div>

						<!-- Sección: Perfil -->
						<div class="space-y-5 pt-6 border-t border-white/5">
							<div class="font-mono text-[10px] text-emerald-400 uppercase tracking-widest">02 / Perfil de actividad</div>
							
							<div>
								<label class="block text-white/40 text-xs mb-2 font-mono">sectores / verticales</label>
								<input
									type="text"
									name="sectores"
									class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20"
									placeholder="Ej: Telecomunicaciones, infraestructuras hospitalarias, consultoría SAP..."
									required
								/>
							</div>

							<div>
								<label class="block text-white/40 text-xs mb-2 font-mono">CPVs objetivo <span class="text-white/20">(opcional)</span></label>
								<select
									name="cpvs"
									multiple
									size="8"
									class="w-full bg-white/5 border border-white/10 rounded px-3 py-2 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors cursor-pointer"
								>
									<!-- TECNOLOGÍA E INFORMÁTICA -->
									<optgroup label="─── TECNOLOGÍA E INFORMÁTICA ───" class="text-emerald-400/60">
										<option value="30.00.00" class="bg-black py-1">30 — Equipos informáticos, software y suministros</option>
										<option value="30.21.31" class="bg-black py-1">30.21.31 — Ordenadores personales</option>
										<option value="30.26.00" class="bg-black py-1">30.26.00 — Equipos de red</option>
										<option value="32.00.00" class="bg-black py-1">32 — Equipos de radio, TV, comunicaciones</option>
										<option value="32.24.00" class="bg-black py-1">32.24.00 — Telecomunicaciones y transmisión</option>
										<option value="32.50.00" class="bg-black py-1">32.50.00 — Equipos de telecomunicaciones</option>
										<option value="33.14.10" class="bg-black py-1">33.14.10 — Equipos de tomografía y resonancia</option>
										<option value="35.00.00" class="bg-black py-1">35 — Seguridad, incendios y defensa</option>
										<option value="35.10.00" class="bg-black py-1">35.10.00 — Sistemas de seguridad</option>
									</optgroup>

									<!-- SERVICIOS TI Y CONSULTORÍA -->
									<optgroup label="─── SERVICIOS TI Y CONSULTORÍA ───" class="text-emerald-400/60">
										<option value="72.00.00" class="bg-black py-1">72 — Servicios TI y consultoría informática</option>
										<option value="72.11.00" class="bg-black py-1">72.11.00 — Consultoría en gestión TI</option>
										<option value="72.21.20" class="bg-black py-1">72.21.20 — Desarrollo de software a medida</option>
										<option value="72.22.20" class="bg-black py-1">72.22.20 — Consultoría y análisis TI</option>
										<option value="72.31.20" class="bg-black py-1">72.31.20 — Servicios de hosting y cloud</option>
										<option value="72.40.00" class="bg-black py-1">72.40.00 — Servicios de bases de datos</option>
										<option value="72.50.00" class="bg-black py-1">72.50.00 — Servicios de mantenimiento TI</option>
										<option value="73.00.00" class="bg-black py-1">73 — Servicios de investigación y desarrollo</option>
									</optgroup>

									<!-- INGENIERÍA Y CONSTRUCCIÓN -->
									<optgroup label="─── INGENIERÍA Y CONSTRUCCIÓN ───" class="text-emerald-400/60">
										<option value="42.00.00" class="bg-black py-1">42 — Obras de ingeniería civil</option>
										<option value="43.00.00" class="bg-black py-1">43 — Obras de construcción</option>
										<option value="43.21.00" class="bg-black py-1">43.21.00 — Construcción de edificios</option>
										<option value="43.31.00" class="bg-black py-1">43.31.00 — Instalaciones eléctricas</option>
										<option value="43.32.00" class="bg-black py-1">43.32.00 — Instalaciones de fontanería</option>
										<option value="43.33.00" class="bg-black py-1">43.33.00 — Instalaciones de calefacción y climatización</option>
										<option value="43.91.00" class="bg-black py-1">43.91.00 — Instalación de techos</option>
										<option value="71.00.00" class="bg-black py-1">71 — Servicios de arquitectura e ingeniería</option>
										<option value="71.11.00" class="bg-black py-1">71.11.00 — Servicios de arquitectura</option>
										<option value="71.12.00" class="bg-black py-1">71.12.00 — Servicios de ingeniería</option>
										<option value="71.20.00" class="bg-black py-1">71.20.00 — Ensayos y análisis técnicos</option>
										<option value="71.22.00" class="bg-black py-1">71.22.00 — Servicios de ingeniería estructural</option>
									</optgroup>

									<!-- TRANSPORTE Y LOGÍSTICA -->
									<optgroup label="─── TRANSPORTE Y LOGÍSTICA ───" class="text-emerald-400/60">
										<option value="34.00.00" class="bg-black py-1">34 — Equipos de transporte</option>
										<option value="34.10.00" class="bg-black py-1">34.10.00 — Vehículos de motor</option>
										<option value="34.14.10" class="bg-black py-1">34.14.10 — Autobuses y autocares</option>
										<option value="34.96.10" class="bg-black py-1">34.96.10 — Señalización ferroviaria</option>
										<option value="60.00.00" class="bg-black py-1">60 — Servicios de transporte por carretera</option>
										<option value="60.11.00" class="bg-black py-1">60.11.00 — Transporte de viajeros por carretera</option>
										<option value="60.12.00" class="bg-black py-1">60.12.00 — Transporte de mercancías por carretera</option>
										<option value="63.11.00" class="bg-black py-1">63.11.00 — Servicios de carga y descarga</option>
									</optgroup>

									<!-- MANTENIMIENTO Y SERVICIOS -->
									<optgroup label="─── MANTENIMIENTO Y SERVICIOS ───" class="text-emerald-400/60">
										<option value="50.00.00" class="bg-black py-1">50 — Servicios de reparación y mantenimiento</option>
										<option value="50.10.00" class="bg-black py-1">50.10.00 — Mantenimiento de vehículos</option>
										<option value="50.41.00" class="bg-black py-1">50.41.00 — Mantenimiento de edificios</option>
										<option value="50.51.00" class="bg-black py-1">50.51.00 — Mantenimiento de instalaciones eléctricas</option>
										<option value="50.53.00" class="bg-black py-1">50.53.00 — Mantenimiento de equipos</option>
										<option value="50.80.00" class="bg-black py-1">50.80.00 — Servicios de reparación de maquinaria</option>
										<option value="79.71.10" class="bg-black py-1">79.71.10 — Servicios de vigilancia y seguridad</option>
										<option value="90.91.92" class="bg-black py-1">90.91.92 — Limpieza de edificios</option>
									</optgroup>

									<!-- SANIDAD Y SERVICIOS SOCIALES -->
									<optgroup label="─── SANIDAD Y SERVICIOS SOCIALES ───" class="text-emerald-400/60">
										<option value="33.00.00" class="bg-black py-1">33 — Equipos médicos y quirúrgicos</option>
										<option value="33.10.00" class="bg-black py-1">33.10.00 — Equipos de diagnóstico y terapia</option>
										<option value="33.19.00" class="bg-black py-1">33.19.00 — Equipos de terapia física</option>
										<option value="85.00.00" class="bg-black py-1">85 — Servicios de salud y asistencia social</option>
										<option value="85.11.00" class="bg-black py-1">85.11.00 — Servicios hospitalarios</option>
										<option value="85.13.00" class="bg-black py-1">85.13.00 — Servicios de práctica médica</option>
										<option value="85.14.00" class="bg-black py-1">85.14.00 — Servicios de práctica dental</option>
									</optgroup>

									<!-- MEDIO AMBIENTE Y ENERGÍA -->
									<optgroup label="─── MEDIO AMBIENTE Y ENERGÍA ───" class="text-emerald-400/60">
										<option value="31.00.00" class="bg-black py-1">31 — Equipos eléctricos</option>
										<option value="31.10.00" class="bg-black py-1">31.10.00 — Motores y generadores eléctricos</option>
										<option value="31.52.12" class="bg-black py-1">31.52.12 — Lámparas y tubos de iluminación</option>
										<option value="38.00.00" class="bg-black py-1">38 — Recolección y tratamiento de residuos</option>
										<option value="38.11.00" class="bg-black py-1">38.11.00 — Recogida de residuos no peligrosos</option>
										<option value="38.12.00" class="bg-black py-1">38.12.00 — Recogida de residuos peligrosos</option>
										<option value="41.00.00" class="bg-black py-1">41 — Captación y distribución de agua</option>
										<option value="90.00.00" class="bg-black py-1">90 — Eliminación de residuos y aguas residuales</option>
										<option value="90.51.00" class="bg-black py-1">90.51.00 — Recogida de aguas residuales</option>
										<option value="90.52.40" class="bg-black py-1">90.52.40 — Gestión de residuos hospitalarios</option>
									</optgroup>

									<!-- FORMACIÓN Y SERVICIOS EDUCATIVOS -->
									<optgroup label="─── FORMACIÓN Y EDUCACIÓN ───" class="text-emerald-400/60">
										<option value="80.00.00" class="bg-black py-1">80 — Servicios de formación y educación</option>
										<option value="80.11.00" class="bg-black py-1">80.11.00 — Educación primaria</option>
										<option value="80.12.00" class="bg-black py-1">80.12.00 — Educación secundaria</option>
										<option value="80.13.00" class="bg-black py-1">80.13.00 — Educación universitaria</option>
										<option value="80.42.00" class="bg-black py-1">80.42.00 — Formación profesional</option>
									</optgroup>

									<!-- OTROS SERVICIOS -->
									<optgroup label="─── OTROS SERVICIOS ───" class="text-emerald-400/60">
										<option value="55.00.00" class="bg-black py-1">55 — Servicios de hostelería</option>
										<option value="64.00.00" class="bg-black py-1">64 — Servicios postales y de telecomunicaciones</option>
										<option value="66.00.00" class="bg-black py-1">66 — Servicios de seguros</option>
										<option value="70.00.00" class="bg-black py-1">70 — Servicios inmobiliarios</option>
										<option value="77.00.00" class="bg-black py-1">77 — Servicios de alquiler de maquinaria</option>
										<option value="78.00.00" class="bg-black py-1">78 — Servicios de contratación de personal</option>
										<option value="92.00.00" class="bg-black py-1">92 — Servicios de esparcimiento y culturales</option>
									</optgroup>
								</select>
								<p class="text-white/20 text-[10px] mt-1.5">Mantenga presionado Ctrl (Cmd en Mac) para seleccionar múltiples CPVs. Lista completa en <a href="https://simap.ted.europa.eu/cpv" target="_blank" class="text-emerald-400/60 hover:text-emerald-400">TED EU →</a></p>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
								<div>
									<label class="block text-white/40 text-xs mb-2 font-mono">tamaño de empresa</label>
									<select
										name="tamanio"
										class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors appearance-none cursor-pointer"
									>
										<option value="" class="bg-black">Seleccionar...</option>
										<option value="pequena" class="bg-black">Pequeña (&lt; 50 empleados)</option>
										<option value="mediana" class="bg-black">Mediana (50-250 empleados)</option>
										<option value="grande" class="bg-black">Grande (&gt; 250 empleados)</option>
									</select>
								</div>
								<div>
									<label class="block text-white/40 text-xs mb-2 font-mono">facturación anual aprox.</label>
									<select
										name="facturacion"
										class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors appearance-none cursor-pointer"
									>
										<option value="" class="bg-black">Seleccionar...</option>
										<option value="menos1m" class="bg-black">&lt; €1M</option>
										<option value="1m5m" class="bg-black">€1M - €5M</option>
										<option value="5m20m" class="bg-black">€5M - €20M</option>
										<option value="20m100m" class="bg-black">€20M - €100M</option>
										<option value="mas100m" class="bg-black">&gt; €100M</option>
									</select>
								</div>
							</div>
						</div>

						<!-- Sección: Intereses -->
						<div class="space-y-5 pt-6 border-t border-white/5">
							<div class="font-mono text-[10px] text-emerald-400 uppercase tracking-widest">03 / Intereses</div>
							
							<div>
								<label class="block text-white/40 text-xs mb-2 font-mono">objetivo principal</label>
								<select
									name="objetivo"
									class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors appearance-none cursor-pointer"
								>
									<option value="" class="bg-black">Seleccionar...</option>
									<option value="deteccion" class="bg-black">Detectar oportunidades antes que la competencia</option>
									<option value="inteligencia" class="bg-black">Conocer a mi competencia en contratos públicos</option>
									<option value="eficiencia" class="bg-black">Optimizar recursos de captación</option>
									<option value="nuevos" class="bg-black">Entrar en nuevos organismos/verticales</option>
									<option value="otros" class="bg-black">Otros</option>
								</select>
							</div>

							<div>
								<label class="block text-white/40 text-xs mb-2 font-mono">horizonte temporal de interés</label>
								<div class="flex gap-4">
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="horizonte" value="6m" class="accent-emerald-500" />
										<span class="text-white/60 text-sm">6 meses</span>
									</label>
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="horizonte" value="12m" class="accent-emerald-500" />
										<span class="text-white/60 text-sm">12 meses</span>
									</label>
									<label class="flex items-center gap-2 cursor-pointer">
										<input type="radio" name="horizonte" value="18m" class="accent-emerald-500" />
										<span class="text-white/60 text-sm">18 meses</span>
									</label>
								</div>
							</div>
						</div>

						<!-- Sección: Comentarios -->
						<div class="space-y-5 pt-6 border-t border-white/5">
							<div class="font-mono text-[10px] text-emerald-400 uppercase tracking-widest">04 / Información adicional</div>
							
							<div>
								<label class="block text-white/40 text-xs mb-2 font-mono">comentarios (opcional)</label>
								<textarea
									name="comentarios"
									rows="4"
									class="w-full bg-white/5 border border-white/10 rounded px-3 py-2 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20 resize-none"
									placeholder="Organismos de interés, CPVs habituales, cualquier información relevante..."
								></textarea>
							</div>
						</div>

						<!-- Submit -->
						<div class="pt-6 border-t border-white/5">
							<button
								type="submit"
								class="w-full md:w-auto inline-flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-sm px-8 py-3 rounded transition-colors"
							>
								Enviar perfil
								<span class="text-emerald-200/60">→</span>
							</button>
							<p class="text-white/20 text-xs mt-4 font-mono">
								Tratamos tus datos según la <a href="/privacy" class="text-emerald-400/60 hover:text-emerald-400">política de privacidad</a>. Respondemos en 24–48 h.
							</p>
						</div>

					</form>
				</div>

				<!-- Separador -->
				<div class="my-16 flex items-center gap-6">
					<div class="flex-1 h-px bg-white/5"></div>
					<span class="text-white/20 text-xs font-mono">o</span>
					<div class="flex-1 h-px bg-white/5"></div>
				</div>

				<!-- Formulario simple: Solicitud de información -->
				<div class="border border-white/5 bg-white/[0.02] rounded-lg p-8">
					<div class="mb-6">
						<p class="font-mono text-white/40 text-xs tracking-widest uppercase mb-3">Consulta rápida</p>
						<h2 class="text-xl text-white font-light">Solicitar información</h2>
						<p class="text-white/30 text-sm mt-2">
							¿Prefieres solo preguntar algo? Déjanos tu email y te respondemos.
						</p>
					</div>

					<form id="form-simple" class="space-y-5">
					<input type="hidden" name="_tipo" value="simple" />
						<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
							<div>
								<label class="block text-white/40 text-xs mb-2 font-mono">nombre</label>
								<input
									type="text"
									name="nombre_simple"
									class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20"
									placeholder="Su nombre"
									required
								/>
							</div>
							<div>
								<label class="block text-white/40 text-xs mb-2 font-mono">email</label>
								<input
									type="email"
									name="email_simple"
									class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20"
									placeholder="email@empresa.com"
									required
								/>
							</div>
						</div>

						<div>
							<label class="block text-white/40 text-xs mb-2 font-mono">empresa</label>
							<input
								type="text"
								name="empresa_simple"
								class="w-full h-10 bg-white/5 border border-white/10 rounded px-3 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20"
								placeholder="Razón social"
							/>
						</div>

						<div>
							<label class="block text-white/40 text-xs mb-2 font-mono">mensaje</label>
							<textarea
								name="mensaje_simple"
								rows="3"
								class="w-full bg-white/5 border border-white/10 rounded px-3 py-2 text-white text-sm focus:border-emerald-500/50 focus:outline-none transition-colors placeholder:text-white/20 resize-none"
								placeholder="¿En qué podemos ayudarte?"
							></textarea>
						</div>

						<button
							type="submit"
							class="inline-flex items-center justify-center gap-2 border border-emerald-500/30 hover:border-emerald-500/60 text-emerald-400 font-mono text-sm px-6 py-2.5 rounded transition-colors"
						>
							Enviar consulta
							<span class="text-emerald-400/40">→</span>
						</button>
					</form>
				</div>

			</div>
		</div>
	</section>
<script>
  async function handleForm(formId: string) {
    const form = document.getElementById(formId) as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const original = btn.innerHTML;
      btn.innerHTML = '<span class="opacity-60">Enviando...</span>';
      btn.disabled = true;

      try {
        const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
        if (res.ok) {
          form.innerHTML = `
            <div class="py-8 text-center space-y-2">
              <div class="text-emerald-400 font-mono text-sm">✓ Enviado correctamente</div>
              <div class="text-white/30 text-xs">Nos pondremos en contacto en 24-48h.</div>
            </div>`;
        } else {
          btn.innerHTML = original;
          btn.disabled = false;
          alert('Error al enviar. Inténtelo de nuevo.');
        }
      } catch {
        btn.innerHTML = original;
        btn.disabled = false;
        alert('Error de conexión. Inténtelo de nuevo.');
      }
    });
  }

  handleForm('form-perfil');
  handleForm('form-simple');
</script>

</Layout>

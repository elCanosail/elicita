---
export const prerender = true;

import Layout from '../layouts/main.astro';
import { latestSnapshotFileReader, loadPublishedMarketSnapshot, readPublishedArtifact } from '@/lib/market-intelligence';
import { aggregateYearly, parseCompanies, parseConcentration, type YearPoint } from '@/lib/faro/csv';
import { formatDecimal, formatEurMillionValue, formatInt } from '@/lib/faro/format';
import { renderHeroTotals } from '@/lib/faro/charts';
import Ticker from '../components/Ticker.astro';

import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/jetbrains-mono';
import { SECTORS } from '@/lib/faro/sectors';
import { getCollection } from 'astro:content';

const metadata = {
  title: 'elicita_ — Todo sobre la contratación pública en España',
  description:
    'Los datos de la contratación pública española, ordenados, verificados y actualizados cada 4 horas: evolución por sectores, ranking de proveedores y mercado consumible por tu agente de IA vía MCP.',
};

// Dato vivo del último snapshot aprobado por sector; sin publicación, la home se degrada con honestidad.
type SectorHome = {
  slug: string;
  nameTitle: string;
  snapshotId: string;
  observed: number;
  contracts: number;
  companies: number;
  from: string;
  to: string;
  series: YearPoint[];
  top1Name: string;
  top1ShareObserved: number;
  top10ShareResolved: number;
};

const published: SectorHome[] = [];
for (const sector of SECTORS) {
  const publication = await loadPublishedMarketSnapshot(latestSnapshotFileReader(sector.dataset));
  if (publication.status !== 'published') continue;
  const { snapshot } = publication.value;
  const [concentrationCsv, companiesCsv, evolutionCsv] = await Promise.all([
    readPublishedArtifact('concentration.csv', sector.dataset),
    readPublishedArtifact('companies.csv', sector.dataset),
    readPublishedArtifact('evolution.csv', sector.dataset),
  ]);
  const amountConc = parseConcentration(concentrationCsv).find((c) => c.dimension === 'companies_amount');
  const top1 = parseCompanies(companiesCsv, 1)[0];
  if (!amountConc || !top1) continue;
  published.push({
    slug: sector.slug,
    nameTitle: sector.nameTitle,
    snapshotId: snapshot.snapshot_id,
    observed: snapshot.metrics.observed_amount_eur,
    contracts: snapshot.universe.analytic_contracts,
    companies: snapshot.metrics.companies,
    from: snapshot.period.from,
    to: snapshot.period.to,
    series: aggregateYearly(evolutionCsv, snapshot.period.to),
    top1Name: top1.name,
    top1ShareObserved: top1.shareAmountPct,
    top10ShareResolved: amountConc.top10,
  });
}

const hasData = published.length > 0;

// Totales anuales del mercado resuelto: suma de los sectores publicados en su
// ventana común (los años que TODOS cubren — cada barra suma la misma población).
const heroTotals = hasData
  ? published
      .map((s) => s.series.map((p) => p.year))
      .reduce<string[]>((common, years) => common.filter((y) => years.includes(y)))
      .sort()
      .map((year) => {
        const pts = published.map((s) => s.series.find((p) => p.year === year)!);
        return {
          year,
          amountEur: Math.round(pts.reduce((sum, p) => sum + p.amountEur, 0) * 100) / 100,
          contracts: pts.reduce((sum, p) => sum + p.contracts, 0),
          partial: pts.some((p) => p.partial),
        };
      })
  : [];

// Corte del año parcial: fechas reales (period.to) de los snapshots publicados.
const MES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
function formatCut(dates: string[]): string {
  if (dates.length === 0) return '';
  const days = dates.map((d) => Number(d.slice(8, 10)));
  const months = dates.map((d) => MES[Number(d.slice(5, 7)) - 1]);
  if (new Set(months).size === 1) {
    return dates.length === 1 ? `${days[0]} ${months[0]}` : `${Math.min(...days)}–${Math.max(...days)} ${months[0]}`;
  }
  return `${days[0]} ${months[0]} – ${days[days.length - 1]} ${months[months.length - 1]}`;
}
const heroCutLabel = hasData ? formatCut([...new Set(published.map((s) => s.to))].sort()) : '';

// Ventana común de los totales, para el subtítulo del gráfico.
const heroWindow = heroTotals.length > 0 ? `${heroTotals[0].year}–${heroTotals[heroTotals.length - 1].year}` : '';

// Totales combinados de los sectores publicados (cada uno cuenta su propio universo).
const totals = hasData
  ? {
      observed: published.reduce((sum, s) => sum + s.observed, 0),
      contracts: published.reduce((sum, s) => sum + s.contracts, 0),
      companies: published.reduce((sum, s) => sum + s.companies, 0),
      companiesDetail: published.map((s) => formatInt(s.companies)).join(' + '),
    }
  : null;

// Ficha: último año completo de la serie (el parcial queda fuera del titular).
function lastFullYear(series: YearPoint[]): YearPoint {
  return [...series].reverse().find((p) => !p.partial) ?? series[0];
}

// Nota editorial interpretable por sector: pocos datos, bien elegidos.
function sectorNote(s: SectorHome): string {
  const top1 = `El mayor proveedor es <strong>${s.top1Name.split(',')[0]}</strong> (${formatDecimal(s.top1ShareObserved, 1)}% de lo observado)`;
  if (s.slug === 'tecnologia') {
    return `${top1}. Los 10 mayores se reparten el ${formatDecimal(s.top10ShareResolved, 1)}% del mercado resuelto: pocos gigantes, mucha cola.`;
  }
  if (s.slug === 'construccion') {
    return `${top1}. Aquí manda lo contrario: ${formatInt(s.companies)} empresas compartiendo la tarta — el mercado más repartido que hemos medido.`;
  }
  return `${top1}. Los 10 mayores concentran el ${formatDecimal(s.top10ShareResolved, 1)}% del mercado resuelto.`;
}

// Análisis destacado: el caso editorial de partida.
const blogSorted = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featured = blogSorted.find((post) => post.id === 'oligopolio-it-publico') ?? blogSorted[0];

// Del blog: las últimas entradas reales (la destacada ya va en banda, sin duplicar).
const recentPosts = blogSorted.filter((post) => post.id !== featured?.id).slice(0, 4);
const fechaEs = (d: Date) => d.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Layout title={metadata.title} description={metadata.description} staticHtml={true}>
  <div class="faro-home">
    <div class="faro-container">
      <header class="faro-hero" id="inicio">
        <p class="faro-kicker">Datos abiertos · Contratación pública en España</p>
        <h1>Todo sobre la contratación pública en España.</h1>
        <p class="faro-lede">
          Cada año, las administraciones adjudican miles de millones en contratos: desde software hasta autopistas.
          <strong>elicita_ lee los anuncios oficiales, los ordena y los publica verificados</strong>, para que
          cualquier persona explore el mercado y cualquier agente de IA trabaje con él.
        </p>

        <p class="faro-fresh">
          <span class="faro-fresh-dot" aria-hidden="true"></span>
          Dataset vivo — los conectores oficiales se leen cada 4 horas.
        </p>

        {hasData ? (
          <>
            {heroTotals.length > 0 && (
              <figure class="faro-chart-card">
                <div class="faro-chart-head">
                  <span class="faro-chart-title">Adjudicado a proveedores identificados, por año</span>
                  <span class="faro-chart-sub">millones de € · suma de los {published.length} sectores publicados · {heroWindow}</span>
                </div>
                <Fragment set:html={renderHeroTotals(heroTotals, { partialCut: heroCutLabel })} />
                <figcaption class="faro-chart-caption">
                  Fuente: evolution.csv de los {published.length} snapshots publicados · checksums.sha256 · CC BY 4.0 · <a href="/datos-abiertos">descarga y metodología</a>
                </figcaption>
                <table class="faro-chart-table">
                  <caption>Importe anual adjudicado a proveedores identificados, en millones de euros</caption>
                  <thead><tr><th scope="col">Año</th><th scope="col">Importe (M€)</th><th scope="col">Estado</th></tr></thead>
                  <tbody>
                    {heroTotals.map((p) => (
                      <tr>
                        <td>{p.year}</td>
                        <td>{formatEurMillionValue(p.amountEur)}</td>
                        <td>{p.partial ? `parcial (corte ${heroCutLabel})` : 'año completo'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </figure>
            )}

            <div class="faro-hero-strip">
              <div class="faro-stat">
                <span class="faro-stat-n">{formatEurMillionValue(totals!.observed)} M€</span>
                <span class="faro-stat-l">observados y verificados</span>
              </div>
              <div class="faro-stat">
                <span class="faro-stat-n">{formatInt(totals!.contracts)}</span>
                <span class="faro-stat-l">contratos analizados</span>
              </div>
              <div class="faro-stat">
                <span class="faro-stat-n">{published.length}</span>
                <span class="faro-stat-l">sectores publicados <span class="faro-chip faro-chip-ok">verificado ✓</span></span>
              </div>
              <div class="faro-stat">
                <span class="faro-stat-n">{formatInt(totals!.companies)}</span>
                <span class="faro-stat-l">proveedores ({totals!.companiesDetail})</span>
              </div>
            </div>
          </>
        ) : (
          <div class="faro-live">
            <div>
              <span class="faro-live-label">Estado</span>
              <span style="font-size:0.9rem;color:var(--faro-ink-2)">El próximo snapshot está en preparación — las fichas se publican solo cuando pasan el sello FARO.</span>
            </div>
          </div>
        )}

        <div class="faro-cta-row">
          <a class="faro-btn faro-btn-primary" href="#sectores">Explorar los datos</a>
          <a class="faro-btn faro-btn-ghost" href="#como">Cómo lo hacemos ↓</a>
        </div>
        {hasData && (
          <p class="faro-src">
            Fuente: snapshots {published.map((s) => s.snapshotId).join(' · ')} — checksums verificados. Lo ámbar es lo aún no sabido, declarado.
          </p>
        )}
      </header>

      <section class="faro-sect" id="que">
        <span class="faro-num">01</span>
        <h2>¿Qué es esto, exactamente?</h2>
        <p class="faro-sub">
          Los datos públicos de contratación existen, pero llegan en bruto: miles de anuncios, formatos distintos,
          importes imposibles. Nosotros los convertimos en algo que se puede leer, comparar y creer.
        </p>
        <div class="faro-steps">
          <div class="faro-step">
            <span class="faro-n">PASO 1</span>
            <h3>De dónde sale el dato</h3>
            <p>De los anuncios oficiales que publica la Administración en la Plataforma de Contratación del Sector Público. Sin fuentes intermedias.</p>
          </div>
          <div class="faro-step">
            <span class="faro-n">PASO 2</span>
            <h3>Cómo se ordena</h3>
            <p>Con reglas públicas y versionadas: se unifican identidades, se corrigen unidades y se marcan importes dudosos. Cada regla es auditable.</p>
          </div>
          <div class="faro-step">
            <span class="faro-n">PASO 3</span>
            <h3>Cómo se comprueba</h3>
            <p>Cada publicación es un snapshot cerrado con suma de control: la cifra que ves hoy es la misma mañana. Si cambia el dato, cambia el sello.</p>
          </div>
        </div>
        <p class="faro-promise">
          ¿Quieres ver las reglas una a una? <a href="#como">Cómo hacemos el trabajo, en detalle →</a>
          <span class="faro-amber-note">Lo <span class="faro-amber-underline">ámbar</span> es todo lo que aún no sabemos, declarado con nombre y conteo.</span>
        </p>
      </section>

      <section class="faro-sect" id="sectores">
        <span class="faro-num">02</span>
        <h2>Los sectores, en detalle</h2>
        <p class="faro-sub">
          Publicamos fichas por sector con evolución, ranking de proveedores y concentración del mercado.
          Solo se publica lo que pasa el sello.
        </p>
        <div class="faro-sector-grid">
          {published.map((s) => {
            const full = lastFullYear(s.series);
            const maxAmount = Math.max(...s.series.map((p) => p.amountEur));
            const miniScale = 62 / maxAmount;
            const miniBars = s.series
              .filter((p) => !p.partial)
              .map((p) => ({
                year: p.year,
                h: Math.max(6, Math.round(p.amountEur * miniScale)),
                label: formatEurMillionValue(p.amountEur),
              }));
            return (
              <a class={`faro-sector-card faro-sector-${s.slug}`} href={`/mercado/${s.slug}`}>
                <h3>{s.nameTitle}</h3>
                <span class="faro-chip faro-chip-ok">verificado ✓</span>
                <div class="faro-sector-big">{formatEurMillionValue(full.amountEur)} M€</div>
                <div class="faro-sector-big-l">adjudicados a proveedores identificados en {full.year}</div>
                <div class="faro-minibars">
                  {miniBars.map((b) => (
                    <div class="faro-minibar" style={`height:${b.h}px`} title={b.label} />
                  ))}
                </div>
                <div class="faro-minibars-x">
                  {miniBars.map((b) => (
                    <span>{b.year}</span>
                  ))}
                </div>
                <p set:html={sectorNote(s)} />
                <span class="faro-go">Abrir ficha de {s.slug === 'tecnologia' ? 'tecnología' : s.slug} →</span>
              </a>
            );
          })}
          <div class="faro-soon">
            <span class="faro-mono-label">próximamente</span>
            Más sectores conforme se apruebe su snapshot — el pipeline CPV y el sello son idénticos para todos.
          </div>
        </div>
      </section>

      <section class="faro-sect" id="producto">
        <span class="faro-num">03</span>
        <h2>Tres formas de usar los datos</h2>
        <p class="faro-sub">
          Del dato abierto para todos a las herramientas para quien vive de esto.
          Lo público nunca se cierra; lo de pago son las herramientas.
        </p>
        <div class="faro-product-grid">
          <div class="faro-prod faro-prod-ok">
            <div class="faro-prod-icon" aria-hidden="true">🔌</div>
            <h3>MCP</h3>
            <span class="faro-chip faro-chip-ok">disponible hoy</span>
            <p>
              Conecta tu agente de IA. Herramientas públicas, gratuitas y sin registro: tu asistente consulta el
              mercado, rankea empresas y analiza compradores por sí mismo.
            </p>
            <div class="faro-prod-code">elicita.es/mcp · 4 herramientas abiertas</div>
            <a class="faro-prod-link" href="/docs/mcp">Guía MCP →</a>
          </div>
          <div class="faro-prod faro-prod-pending">
            <div class="faro-prod-icon" aria-hidden="true">📊</div>
            <h3>Dashboard</h3>
            <span class="faro-chip faro-chip-warn">en camino</span>
            <p>
              El mercado en tu pantalla. Evolución, rankings y concentración por sector, sin escribir una línea de
              código. La capa privada de elicita_.
            </p>
            <div class="faro-prod-code faro-prod-code-dim">lista de espera</div>
          </div>
          <div class="faro-prod faro-prod-pending">
            <div class="faro-prod-icon" aria-hidden="true">📡</div>
            <h3>Alertas</h3>
            <span class="faro-chip faro-chip-warn">en camino</span>
            <p>
              Tu radar de oportunidades. Te avisamos cuando aparece un contrato que encaja con lo que ya haces —
              sector, organismo y tamaño a tu medida.
            </p>
            <div class="faro-prod-code faro-prod-code-dim">lista de espera</div>
          </div>
        </div>
      </section>

      <section class="faro-sect" id="como">
        <span class="faro-num">04</span>
        <h2>¿Cómo lo sabemos?</h2>
        <p class="faro-sub">
          Tres preguntas que hacernos antes de creer una cifra — las nuestras incluidas. Aquí va nuestra respuesta a cada una.
        </p>
        <div class="faro-how-grid">
          <div class="faro-how faro-how-emerald">
            <h3>¿De qué población hablamos?</h3>
            <p>
              Cada cifra declara su base: el <strong>universo observado</strong> (todo lo que entró en el snapshot) o el
              <strong>mercado resuelto</strong> (solo contratos con adjudicatario identificado). Ambas se publican, siempre.
            </p>
          </div>
          <div class="faro-how faro-how-amber">
            <h3>¿Qué se ha excluido?</h3>
            <p>
              Si un registro de la fuente es erróneo — y pasa —, se retira con evidencia pública del porqué. El sello
              funciona en ambos sentidos: ni nuestra memoria ni la fuente son verdad hasta verificarlas.
            </p>
          </div>
          <div class="faro-how faro-how-blue">
            <h3>¿Cómo lo verifico yo?</h3>
            <p>
              Cada cifra enlaza al snapshot y a su checksum. Cualquiera puede recalcularla bit a bit desde la fuente
              oficial, sin confiar en nosotros. Ese es el punto.
            </p>
          </div>
        </div>
        <p class="faro-promise">
          La metodología completa, las reglas y las limitaciones: <a href="/datos-abiertos">metodología y descarga de snapshots →</a>
        </p>
      </section>

      {featured && (
        <section class="faro-sect faro-analysis" id="analisis">
          <div class="faro-analysis-band">
            <div>
              <p class="faro-kicker">Análisis</p>
              <h3>{featured.data.title}</h3>
              <p class="faro-analysis-copy">{featured.data.excerpt}</p>
            </div>
            <a class="faro-analysis-link" href={`/blog/${featured.id}`}>Leer el análisis →</a>
          </div>
          {recentPosts.length > 0 && (
            <div class="faro-blog-list">
              <p class="faro-mono-label faro-blog-label">Del blog — las últimas</p>
              {recentPosts.map((post) => (
                <a class="faro-blog-row" href={`/blog/${post.id}`}>
                  <span class="faro-blog-date">{fechaEs(post.data.date)}</span>
                  <span class="faro-blog-main">
                    <span class="faro-blog-title">{post.data.title}</span>
                    <span class="faro-blog-excerpt">{post.data.excerpt}</span>
                  </span>
                  <span class="faro-blog-go" aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          )}
          <p class="faro-promise" style="margin-top:1rem">
            Radiografías y casos del mercado: <a href="/blog">todo el blog →</a>
          </p>
        </section>
      )}

      <section class="faro-bridge" id="observatorio">
        <p class="faro-kicker">Capa privada · elicita_ Observatorio</p>
        <h2>Para quien vive de esto</h2>
        <p>
          MCP con cuenta y cuota ampliada, Dashboard a medida y alertas de oportunidades. La capa oscura de elicita_
          para consultoras, proveedores y equipos de venta.
        </p>
        <div class="faro-tools">
          <span class="faro-tool">radar_opportunities</span>
          <span class="faro-tool">graph_search</span>
          <span class="faro-tool">graph_contracts</span>
          <span class="faro-tool">analyze_pliego</span>
          <span class="faro-tool">alertas</span>
        </div>
        <div class="faro-cta-row">
          <a class="faro-btn faro-btn-primary-dark" href="/dashboard">Entrar al observatorio</a>
          <span class="faro-free">El dato abierto es y seguirá siendo público y gratuito. Siempre.</span>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style is:global>
  /* FARO home v2 — pedagógica y visual-first: el gráfico manda, la jerga se queda en las fichas.
     Registro cívico claro sobre el chrome del sitio; cero JS de aplicación. */
  .faro-home {
    --faro-paper: oklch(0.977 0.005 160);
    --faro-paper-raised: oklch(0.955 0.008 160);
    --faro-paper-deep: oklch(0.93 0.012 160);
    --faro-ink: oklch(0.25 0.02 165);
    --faro-ink-2: oklch(0.42 0.025 165);
    --faro-ink-3: oklch(0.55 0.02 165);
    --faro-civic: oklch(0.50 0.11 163);
    --faro-emerald: oklch(0.72 0.15 162);
    --faro-emerald-soft: oklch(0.93 0.06 162);
    --faro-blue: oklch(0.55 0.13 245);
    --faro-amber: oklch(0.60 0.12 75);
    --faro-amber-soft: oklch(0.85 0.08 85);
    --faro-line: oklch(0.86 0.012 160);
    --faro-dark: oklch(0.22 0.03 165);
    --faro-dark-2: oklch(0.28 0.03 165);
    --faro-serif: 'Source Serif 4 Variable', Georgia, serif;
    --faro-sans: 'Instrument Sans Variable', system-ui, sans-serif;
    --faro-mono: 'JetBrains Mono Variable', ui-monospace, monospace;
    background: var(--faro-paper);
    color: var(--faro-ink);
    font-family: var(--faro-sans);
    font-size: 16.5px;
    line-height: 1.6;
  }
  .faro-home .faro-container {
    max-width: 74rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
  }
  .faro-home .faro-mono-label { font-family: var(--faro-mono); font-variant-numeric: tabular-nums; }
  .faro-home a { color: inherit; }

  .faro-home .faro-kicker {
    font-family: var(--faro-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faro-civic);
    margin: 0;
  }

  /* Hero */
  .faro-home .faro-hero { max-width: 64rem; }
  .faro-home .faro-hero h1 {
    font-family: var(--faro-serif);
    font-weight: 600;
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 1.1rem 0 1.3rem;
  }
  .faro-home .faro-lede {
    font-size: 1.28rem;
    line-height: 1.55;
    color: var(--faro-ink-2);
    max-width: 46rem;
    margin: 0;
  }
  .faro-home .faro-lede strong { color: var(--faro-ink); font-weight: 600; }

  /* Sello de frescura: dataset vivo, sin megáfono. */
  .faro-home .faro-fresh {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.1rem;
    font-family: var(--faro-mono);
    font-size: 0.8rem;
    color: var(--faro-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .faro-home .faro-fresh-dot {
    width: 0.5rem;
    height: 0.5rem;

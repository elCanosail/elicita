<script is:inline>
  // ── Mobile sidebar toggle ──────────────────────────────────────────────────
  (function() {
    const toggle = document.getElementById('sidebar-toggle');
    const sidebar = document.querySelector('aside');
    const backdrop = document.getElementById('sidebar-backdrop');
    if (!toggle || !sidebar || !backdrop) return;
    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('open');
      backdrop.classList.toggle('open');
    });
    backdrop.addEventListener('click', () => {
      sidebar.classList.remove('open');
      backdrop.classList.remove('open');
    });
    sidebar.querySelectorAll('nav a').forEach(a => {
      a.addEventListener('click', () => {
        sidebar.classList.remove('open');
        backdrop.classList.remove('open');
      });
    });
  })();

  // ── Upgrade banner: remember dismiss in localStorage ───────────────────────
  (function() {
    const banner = document.getElementById('upgrade-banner');
    const closeBtn = document.getElementById('upgrade-banner-close');
    if (!banner || !closeBtn) return;
    const key = 'elicita_upgrade_banner_dismissed';
    try {
      if (localStorage.getItem(key)) {
        banner.classList.add('hidden');
      }
    } catch { /* storage disabled */ }
    closeBtn.addEventListener('click', function() {
      banner.classList.add('hidden');
      try { localStorage.setItem(key, '1'); } catch {}
    });
  })();

  // ── Setup banner: remember dismiss in localStorage ───────────────────────────
  (function() {
    const banner = document.getElementById('setup-banner');
    const closeBtn = document.getElementById('setup-banner-close');
    if (!banner || !closeBtn) return;
    const key = 'elicita_setup_banner_dismissed';
    try {
      if (localStorage.getItem(key)) {
        banner.classList.add('hidden');
      }
    } catch { /* storage disabled */ }
    closeBtn.addEventListener('click', function() {
      banner.classList.add('hidden');
      try { localStorage.setItem(key, '1'); } catch {}
    });
  })();

  // ── Theme toggle: light / dark with localStorage persistence ─────────────────
  (function() {
    const root = document.documentElement;
    const toggleBtn = document.getElementById('theme-toggle');
    const iconEl = document.getElementById('theme-icon');
    const labelEl = document.getElementById('theme-label');
    if (!toggleBtn) return;

    const STORAGE_KEY = 'elicita-theme';

    function isDark() {
      return root.classList.contains('dark');
    }

    function updateUI() {
      const dark = isDark();
      if (iconEl) iconEl.textContent = dark ? '🌙' : '☀️';
      if (labelEl) labelEl.textContent = dark ? 'Tema oscuro' : 'Tema claro';
    }

    function setTheme(theme) {
      if (theme === 'light') {
        root.classList.remove('dark');
        root.classList.add('light');
      } else {
        root.classList.remove('light');
        root.classList.add('dark');
      }
      try { localStorage.setItem(STORAGE_KEY, theme); } catch {}
      updateUI();
    }

    toggleBtn.addEventListener('click', function() {
      setTheme(isDark() ? 'light' : 'dark');
    });

    // Sync if changed from another tab
    window.addEventListener('storage', function(e) {
      if (e.key === STORAGE_KEY) {
        const t = e.newValue;
        if (t === 'light' || t === 'dark') setTheme(t);
      }
    });

    updateUI();
  })();
</script>

<script>
  // Profile-aware sidebar: load company name if available, update status bar.
  // Cache /api/data response so monitor pages can reuse it instead of refetching.
  (async function() {
    try {
      const [profileRes, dataRes] = await Promise.all([
        fetch('/api/profile'),
        fetch('/api/data')
      ]);

      if (profileRes.ok) {
        const pj = await profileRes.json();
        const nombre = pj?.data?.empresa;
        if (nombre) {
          const el = document.getElementById('sidebar-client-name');
          if (el) el.textContent = nombre;
        }
      }

      if (dataRes.ok) {
        const dj = await dataRes.json();
        // Share lightweight metadata with monitor pages to avoid a second /api/data fetch.
        window.__elicitaStatusBar = {
          lastUpdate: dj?.ultima_actualizacion || null,
          totalResults: dj?.total ?? (dj?.contratos?.length || 0)
        };
        const lastUpdate = dj?.ultima_actualizacion;
        const statusEl = document.getElementById('status-text');
        if (statusEl) {
          let timeAgo = '';
          if (lastUpdate) {
            const diff = Date.now() - new Date(lastUpdate).getTime();
            const hours = Math.floor(diff / 3600000);
            const mins = Math.floor(diff / 60000);
            if (hours > 24) timeAgo = `hace ${Math.floor(hours/24)}d`;
            else if (hours > 0) timeAgo = `hace ${hours}h`;
            else timeAgo = `hace ${mins}min`;
          }
          statusEl.textContent = timeAgo ? `Última actualización: ${timeAgo}.` : '';
        }
      }
    } catch {
      const statusEl = document.getElementById('status-text');
      if (statusEl) statusEl.textContent = 'Sin conexión';
    }
  })();
</script>

<script>
// ── Command Palette ⌘K ──────────────────────────────────────────────────────
(function() {
  const overlay   = document.getElementById('cmdk-overlay');
  const modal     = document.getElementById('cmdk-modal');
  const input     = document.getElementById('cmdk-input');
  const results   = document.getElementById('cmdk-results');
  const trigger   = document.getElementById('cmdk-trigger');

  let cache = null;
  let allItems = [];
  let filtered = [];
  let selectedIndex = -1;
  let debounceTimer = null;
  let isOpen = false;

  // ── Static pages (Monitor + Explorer) ────────────────────────────────────
  const PAGES = [
    { type: 'page', icon: '📡', label: 'Activas', url: '/monitor/activas', section: 'Monitor' },
    { type: 'page', icon: '🏁', label: 'Terminales', url: '/monitor/terminales', section: 'Monitor' },
    { type: 'page', icon: '🎯', label: 'Predicciones', url: '/explorer',  section: 'Explorer' },
    { type: 'page', icon: '⚙',  label: 'Perfil de empresa', url: '/cuenta/onboard', section: 'Cuenta' },
  ];

  // ── Load data ──────────────────────────────────────────────────────────────
  async function loadData() {
    if (cache) return cache;
    try {
      const [dataRes, profileRes] = await Promise.allSettled([
        fetch('/api/data'),
        fetch('/api/profile'),
      ]);

      let contracts = [];
      let competitors = [];

      if (dataRes.status === 'fulfilled' && dataRes.value.ok) {
        const json = await dataRes.value.json();
        const raw = json?.contratos ?? json?.data ?? json ?? [];
        contracts = Array.isArray(raw) ? raw : [];
      }

      if (profileRes.status === 'fulfilled' && profileRes.value.ok) {
        const json = await profileRes.value.json();
        const raw = json?.data?.competidores ?? json?.competidores ?? [];
        competitors = Array.isArray(raw) ? raw : [];
      }

      cache = { contracts, competitors };
      buildIndex();
      return cache;
    } catch (e) {
      console.warn('[cmdk] loadData error', e);
      cache = { contracts: [], competitors: [] };
      buildIndex();
      return cache;
    }
  }

  function buildIndex() {
    allItems = [];

    (cache.contracts || []).forEach(c => {
      const id = c.id ?? c._id ?? c.expediente ?? '';
      const label = c.objeto ?? c.titulo ?? c.title ?? String(id);
      const org   = c.organismo ?? c.organo_contratacion ?? c.entidad ?? '';
      allItems.push({ type: 'contrato', icon: '📄', label, sub: org, id, url: `/monitor/licitacion/${id}` });
    });

    const orgsSet = new Map();
    (cache.contracts || []).forEach(c => {
      const org = c.organismo ?? c.organo_contratacion ?? c.entidad ?? '';
      if (org && !orgsSet.has(org)) {
        orgsSet.set(org, true);
        allItems.push({ type: 'organismo', icon: '🏛', label: org, sub: '', url: `/monitor?org=${encodeURIComponent(org)}` });
      }
    });

    PAGES.forEach(p => allItems.push(p));

    (cache.competitors || []).forEach(comp => {
      const name = typeof comp === 'string' ? comp : (comp.nombre ?? comp.name ?? String(comp));
      allItems.push({ type: 'competidor', icon: '🏢', label: name, sub: '', url: '/explorer' });
    });
  }

  // ── Search ─────────────────────────────────────────────────────────────────
  function search(query) {
    const q = query.toLowerCase().trim();
    if (!q) return PAGES.map(p => ({ ...p }));
    return allItems.filter(item =>
      item.label.toLowerCase().includes(q) ||
      (item.sub && item.sub.toLowerCase().includes(q))
    ).slice(0, 40);
  }

  // ── Render ─────────────────────────────────────────────────────────────────
  const CATEGORY_LABELS = {
    contrato:  '📄 Contratos',
    organismo: '🏛 Organismos',
    page:      '📊 Páginas',
    competidor:'🏢 Competidores',
  };

  function render(items) {
    filtered = items;
    selectedIndex = items.length > 0 ? 0 : -1;

    if (!items.length) {
      results.innerHTML = '';
      return;
    }

    let html = '';
    let lastType = null;
    items.forEach((item, i) => {
      const t = item.type;
      if (t !== lastType) {
        html += `<div class="cmdk-category">${CATEGORY_LABELS[t] ?? t}</div>`;
        lastType = t;
      }
      const sel = i === selectedIndex ? ' selected' : '';
      const sub = item.sub ? `<span class="cmdk-sub">${escHtml(item.sub)}</span>` : '';
      html += `<div class="cmdk-item${sel}" data-index="${i}" data-url="${escAttr(item.url)}">
        <span class="cmdk-icon">${item.icon}</span>
        <span>${escHtml(item.label)}</span>
        ${sub}
      </div>`;
    });
    results.innerHTML = html;
    attachItemListeners();
    scrollSelectedIntoView();
  }

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }
  function escAttr(s) {
    return String(s).replace(/"/g,'&quot;');
  }

  function attachItemListeners() {
    results.querySelectorAll('.cmdk-item').forEach(el => {
      el.addEventListener('mouseenter', () => {
        selectedIndex = Number(el.dataset.index);
        updateSelected();
      });
      el.addEventListener('click', () => {
        navigate(el.dataset.url);
      });
    });
  }

  function updateSelected() {
    results.querySelectorAll('.cmdk-item').forEach((el, i) => {
      el.classList.toggle('selected', i === selectedIndex);
    });
    scrollSelectedIntoView();
  }

  function scrollSelectedIntoView() {
    const el = results.querySelector('.cmdk-item.selected');
    if (el) el.scrollIntoView({ block: 'nearest' });
  }

  function navigate(url) {
    if (!url) return;
    close();
    window.location.href = url;
  }

  async function open() {
    isOpen = true;
    overlay.style.display = 'block';
    input.value = '';
    render(PAGES);
    input.focus();
    loadData().then(() => {
      if (isOpen) render(search(input.value));
    });
  }

  function close() {
    isOpen = false;
    overlay.style.display = 'none';
    input.value = '';
    results.innerHTML = '';
    selectedIndex = -1;
  }

  function toggle() {
    isOpen ? close() : open();
  }

  document.addEventListener('keydown', e => {
    const isK = e.key === 'k' || e.key === 'K';
    if ((e.metaKey || e.ctrlKey) && isK) {
      e.preventDefault();
      toggle();
      return;
    }
    if (!isOpen) return;

    if (e.key === 'Escape') { e.preventDefault(); close(); return; }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = Math.min(selectedIndex + 1, filtered.length - 1);
      updateSelected();
      return;
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = Math.max(selectedIndex - 1, 0);
      updateSelected();
      return;
    }
    if (e.key === 'Enter') {
      e.preventDefault();
      const item = filtered[selectedIndex];
      if (item) navigate(item.url);
      return;
    }
  });

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      render(search(input.value));
    }, 150);
  });

  overlay.addEventListener('click', e => {
    if (e.target === overlay) close();
  });

  if (trigger) trigger.addEventListener('click', open);
})();
</script>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  var btn = document.getElementById('feedback-btn');
  var modal = document.getElementById('feedback-modal');
  var backdrop = modal ? modal.querySelector('.feedback-backdrop') : null;
  var closeBtn = document.getElementById('feedback-close');
  var form = document.getElementById('feedback-form');
  var textArea = document.getElementById('feedback-text');
  var submitBtn = document.getElementById('feedback-submit');
  var successEl = document.getElementById('feedback-success');
  var errorEl = document.getElementById('feedback-error');
  if (!btn || !modal) return;

  var selectedType = 'otro';

  modal.querySelectorAll('.feedback-type').forEach(function(b) {
    b.addEventListener('click', function() {
      modal.querySelectorAll('.feedback-type').forEach(function(x) { x.classList.remove('active'); });
      b.classList.add('active');
      selectedType = b.dataset.type || 'otro';
    });
  });

  function openModal() { modal.style.display = 'flex'; if (textArea) textArea.focus(); }
  function closeModal() {
    modal.style.display = 'none';
    if (form) form.reset();
    if (successEl) successEl.style.display = 'none';
    if (errorEl) errorEl.style.display = 'none';
    if (submitBtn) { submitBtn.style.display = ''; submitBtn.disabled = false; submitBtn.textContent = 'Enviar'; }
    modal.querySelectorAll('.feedback-type').forEach(function(x) { x.classList.remove('active'); });
    selectedType = 'otro';
  }

  btn.addEventListener('click', openModal);
  if (backdrop) backdrop.addEventListener('click', closeModal);
  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && modal.style.display !== 'none') closeModal(); });

  if (form) form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (!textArea || !textArea.value.trim()) return;
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando...'; }
    if (errorEl) errorEl.style.display = 'none';

    fetch('/api/feedback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ type: selectedType, message: textArea.value.trim() })
    }).then(function(res) {
      if (res.ok) {
        form.reset();
        if (submitBtn) submitBtn.style.display = 'none';
        if (successEl) successEl.style.display = '';
        setTimeout(closeModal, 1500);
      } else { throw new Error(); }
    }).catch(function() {
      if (errorEl) errorEl.style.display = '';
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Enviar'; }
    });
  });
});
</script>




---
// Dashboard layout — elicita_ (unified)
// Protegido por Clerk middleware (src/middleware.ts)
// Sidebar: Monitor (Licitaciones) + Explorer (Predicciones)
import '../styles/global.css';
import { clerkClient } from '@clerk/astro/server';
import { getUserPlan } from '../lib/plan';

const { title = "dashboard_ — elicita_", isDemo = false } = Astro.props;
const pathname = Astro.url.pathname;

// Detect plan + CIF for upgrade CTA and onboard redirect
let userPlan = { plan: 'free' as const, hasAccess: true, planName: 'Free' };
let hasCif = false;
let clientName = '—';
try {
  const auth = (Astro.locals as any).auth?.();
  const userId = auth?.userId;
  console.log('[PLAN-DEBUG] userId:', userId);
  if (userId) {
    const client = clerkClient({ secretKey: import.meta.env.CLERK_SECRET_KEY });
    const user = await client.users.getUser(userId);
    const meta = (user.publicMetadata as Record<string, any>) || {};
    console.log('[PLAN-DEBUG] username:', user.username, 'meta.plan:', meta.plan, 'meta.plan_status:', meta.plan_status);
    userPlan = getUserPlan(meta, user.username || undefined, userId);
    console.log('[PLAN-DEBUG] resolved plan:', userPlan.plan, 'hasAccess:', userPlan.hasAccess);
    hasCif = !!meta.cif;
    if (meta.cif) clientName = meta.cif;
  }
} catch { /* non-fatal */ }

const isFree = userPlan.plan === 'free';
// Trial removed — only Free and Pro plans exist

// Onboard redirect is handled in middleware — layout just shows the UI
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Plausible Analytics -->
  <script defer data-domain="elicita.es" src="https://analytics.elicita.es/js/script.js"></script>

  <!-- Theme init — respect prefers-color-scheme, default to dark via localStorage fallback -->
  <script is:inline>
    (function () {
      const root = document.documentElement;
      const stored = (function () {
        try { return localStorage.getItem('elicita-theme'); }
        catch (e) { return null; }
      })();

      if (stored === 'light') {
        root.classList.remove('dark');
        root.classList.add('light');
      } else if (stored === 'dark') {
        root.classList.add('dark');
        root.classList.remove('light');
      } else {
        // No stored preference: use system if available, otherwise default to dark (legacy behavior)
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
          root.classList.remove('dark');
          root.classList.add('light');
        } else {
          root.classList.add('dark');
          root.classList.remove('light');
        }
      }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.gstatic.com/s/instrumentsans/v4/pxiTypc9vsFDm051Uf6KVwgkfoSxQ0GsQv8ToedPibnr0She1YmV.woff2" as="font" type="font/woff2" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: 'Instrument Sans', sans-serif;
      background: hsl(var(--background));
      color: hsl(var(--foreground));
      display: flex;
    }
    .mono { font-family: 'JetBrains Mono', monospace; }

    /* Focus visible — global accessible outline for all interactive elements */
    a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, [tabindex]:focus-visible {
      outline: 2px solid hsl(152 60% 45%);
      outline-offset: 2px;
      border-radius: 4px;
    }
    /* Never remove outline without a focus-visible replacement */
    *:focus { outline: none; }

    /* Sidebar */
    aside {
      width: 220px;
      min-width: 220px;
      height: 100vh;
      position: sticky;
      top: 0;
      background: hsl(var(--background));
      border-right: 1px solid hsl(var(--border));
      display: flex;
      flex-direction: column;
      padding: 0;
      overflow: hidden;
    }
    .sidebar-logo {
      padding: 24px 20px 20px;
      border-bottom: 1px solid hsl(var(--border));
    }
    .sidebar-logo a {
      font-family: 'JetBrains Mono', monospace;
      font-size: 15px;
      color: hsl(var(--foreground));
      text-decoration: none;
      letter-spacing: -0.5px;
    }
    .sidebar-logo a span { color: hsl(var(--emerald)); animation: blink 1.2s infinite; }
    @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

    /* Theme toggle button */
    .theme-toggle {
      display: flex;
      align-items: center;
      gap: 6px;
      background: none;
      border: 1px solid hsl(var(--foreground) / 0.08);
      border-radius: 4px;
      padding: 6px 8px;
      font-family: 'Instrument Sans', sans-serif;
      font-size: 11px;
      color: hsl(var(--foreground) / 0.35);
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
      width: 100%;
      margin-bottom: 10px;
    }
    .theme-toggle:hover { color: hsl(var(--foreground) / 0.6); border-color: hsl(var(--foreground) / 0.15); }

    .sidebar-client {
      margin: 12px 16px;
      padding: 10px 12px;
      background: hsl(var(--emerald) 0.06);
      border: 1px solid hsl(var(--emerald) 0.12);
      border-radius: 6px;
    }
    .sidebar-client .label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      color: hsl(var(--emerald) 0.6);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 3px;
    }
    .sidebar-client .name {
      font-size: 11px;
      color: hsl(var(--foreground) / 0.7);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    nav { flex: 1; padding: 8px 0; overflow-y: auto; }
    .nav-section {
      padding: 12px 16px 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      color: hsl(var(--foreground) / 0.2);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    nav a {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 20px;
      font-family: 'Instrument Sans', sans-serif;
      font-size: 13px;
      color: hsl(var(--foreground) / 0.4);
      text-decoration: none;
      transition: color 0.15s, background 0.15s;
      border-left: 2px solid transparent;
    }
    nav a:hover { color: hsl(var(--foreground) / 0.7); background: hsl(var(--foreground) / 0.03); }
    nav a.active { color: hsl(var(--foreground) / 0.9); border-left-color: hsl(var(--emerald)); background: hsl(var(--emerald) 0.05); }
    nav a .icon { font-size: 12px; width: 16px; text-align: center; opacity: 0.7; }

    .sidebar-bottom {
      padding: 16px;
      border-top: 1px solid hsl(var(--foreground) / 0.05);
    }
    .sidebar-bottom a {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: hsl(var(--foreground) / 0.25);
      text-decoration: none;
      padding: 6px 4px;
      transition: color 0.15s;
    }
    .sidebar-bottom a:hover { color: hsl(var(--foreground) / 0.5); }

    .upgrade-cta {
      display: flex !important;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 12px !important;
      font-weight: 500;
      color: hsl(var(--emerald)) !important;
      text-decoration: none;
      padding: 8px 12px !important;
      margin-bottom: 8px;
      background: hsl(var(--emerald) 0.08);
      border: 1px solid hsl(var(--emerald) 0.2);
      border-radius: 6px;
      transition: background 0.15s, border-color 0.15s !important;
    }
    .upgrade-cta:hover {
      background: hsl(var(--emerald) 0.14) !important;
      border-color: hsl(var(--emerald) 0.35) !important;
      color: hsl(var(--emerald)) !important;
    }
    .upgrade-cta {
      display: flex !important;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 12px !important;
      font-weight: 600;
      color: hsl(var(--primary)) !important;
      text-decoration: none;
      padding: 8px 12px !important;
      margin-bottom: 8px;
      background: hsl(var(--primary) / 0.08);
      border: 1px solid hsl(var(--primary) / 0.2);
      border-radius: 6px;
      transition: background 0.15s, border-color 0.15s !important;
    }
    .upgrade-cta:hover {
      background: hsl(var(--primary) / 0.14) !important;
      border-color: hsl(var(--primary) / 0.35) !important;
      color: hsl(var(--primary)) !important;
    }

    /* Top upgrade banner for free users */
    .upgrade-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      height: 40px;
      padding: 0 20px;
      background: hsl(var(--emerald) 0.05);
      border-bottom: 1px solid hsl(var(--emerald) 0.12);
      font-size: 12px;
      color: hsl(var(--foreground) / 0.55);
      flex-shrink: 0;
      transition: opacity 0.2s, transform 0.2s;
    }
    .upgrade-banner.hidden {
      display: none;
    }
    .upgrade-banner .upgrade-text {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .upgrade-banner .upgrade-plan {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: hsl(var(--emerald));
      background: hsl(var(--emerald) 0.1);
      border: 1px solid hsl(var(--emerald) 0.25);
      border-radius: 4px;
      padding: 2px 8px;
    }
    .upgrade-banner .upgrade-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .upgrade-banner .upgrade-btn {
      font-size: 12px;
      font-weight: 500;
      color: hsl(var(--emerald));
      text-decoration: none;
      border: 1px solid hsl(var(--emerald) 0.3);
      padding: 4px 12px;
      border-radius: 4px;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .upgrade-banner .upgrade-btn:hover { background: hsl(var(--emerald) 0.1); }
    .upgrade-banner .upgrade-close {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      background: none;
      border: none;
      border-radius: 4px;
      color: hsl(var(--foreground) / 0.3);
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      padding: 0;
    }
    .upgrade-banner .upgrade-close:hover {
      background: hsl(var(--foreground) / 0.05);
      color: hsl(var(--foreground) / 0.6);
    }
    @media (max-width: 767px) {
      .upgrade-banner { padding: 0 16px; gap: 10px; }
      .upgrade-banner .upgrade-text { font-size: 11px; }
      .upgrade-banner .upgrade-btn { padding: 3px 10px; font-size: 11px; }
      .upgrade-banner .upgrade-close { width: 22px; height: 22px; }
    }

    /* Demo banner */
    .demo-banner {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 40px;
      padding: 0 20px;
      background: hsl(var(--warning) / 0.08);
      border-bottom: 1px solid hsl(var(--warning) / 0.2);
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: hsl(var(--warning) / 0.9);
      flex-shrink: 0;
    }
    .demo-banner .demo-text { display: flex; align-items: center; gap: 8px; }
    .demo-banner .demo-cta {
      font-size: 11px;
      color: hsl(var(--emerald));
      text-decoration: none;
      border: 1px solid hsl(var(--emerald) 0.3);
      padding: 4px 10px;
      border-radius: 4px;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .demo-banner .demo-cta:hover { background: hsl(var(--emerald) 0.1); }

    /* Setup banner (no CIF) */
    .setup-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 36px;
      padding: 0 20px;
      background: hsl(var(--emerald) 0.04);
      border-bottom: 1px solid hsl(var(--emerald) 0.1);
      font-size: 12px;
      color: hsl(var(--foreground) / 0.5);
      flex-shrink: 0;
    }
    .setup-banner .setup-text { display: flex; align-items: center; gap: 8px; }
    .setup-banner .setup-cta {
      font-size: 11px;
      color: hsl(var(--emerald));
      text-decoration: none;
      border: 1px solid hsl(var(--emerald) 0.2);
      padding: 3px 10px;
      border-radius: 4px;
      transition: background 0.15s;
      white-space: nowrap;
    }
    .setup-banner .setup-cta:hover { background: hsl(var(--emerald) 0.08); }

    /* Feedback */
    .feedback-trigger {
      display: flex; align-items: center; gap: 6px;
      background: none; border: 1px solid hsl(var(--foreground) / 0.08);
      border-radius: 4px; padding: 3px 10px;
      color: hsl(var(--foreground) / 0.35); font-size: 11px;
      cursor: pointer; transition: all 0.15s;
    }
    .feedback-trigger:hover { color: hsl(var(--foreground) / 0.6); border-color: hsl(var(--foreground) / 0.15); }
    .feedback-trigger span { font-family: 'Instrument Sans', sans-serif; }
    .feedback-overlay {
      position: fixed; inset: 0; z-index: 200;
      display: flex; align-items: center; justify-content: center;
    }
    .feedback-backdrop { position: absolute; inset: 0; background: hsl(var(--background) / 0.6); }
    .feedback-dialog {
      position: relative; background: hsl(var(--background));
      border: 1px solid hsl(var(--foreground) / 0.1); border-radius: 8px;
      width: 100%; max-width: 420px; margin: 16px;
      box-shadow: 0 25px 50px hsl(var(--background) / 0.5);
    }
    .feedback-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 20px; border-bottom: 1px solid hsl(var(--foreground) / 0.05);
    }
    .feedback-header-left { display: flex; align-items: center; gap: 8px; color: hsl(var(--foreground) / 0.85); font-size: 14px; font-weight: 600; }
    .feedback-close-btn { background: none; border: none; color: hsl(var(--foreground) / 0.3); cursor: pointer; padding: 4px; }
    .feedback-close-btn:hover { color: hsl(var(--foreground) / 0.6); }
    .feedback-body { padding: 20px; display: flex; flex-direction: column; gap: 12px; }
    .feedback-types { display: flex; gap: 8px; }
    .feedback-type {
      flex: 1; background: hsl(var(--foreground) / 0.03); border: 1px solid hsl(var(--foreground) / 0.08);
      border-radius: 4px; padding: 8px; font-size: 12px; color: hsl(var(--foreground) / 0.4);
      cursor: pointer; transition: all 0.15s; text-align: center;
    }
    .feedback-type:hover { border-color: hsl(var(--foreground) / 0.15); color: hsl(var(--foreground) / 0.6); }
    .feedback-type.active { border-color: hsl(var(--emerald) 0.4); color: hsl(var(--emerald)); }
    .feedback-body textarea {
      width: 100%; background: hsl(var(--foreground) / 0.03);
      border: 1px solid hsl(var(--foreground) / 0.08); border-radius: 4px;
      padding: 10px 12px; color: hsl(var(--foreground) / 0.85);
      font-size: 13px; font-family: 'Instrument Sans', sans-serif;
      resize: none; transition: border-color 0.15s;
    }
    .feedback-body textarea::placeholder { color: hsl(var(--foreground) / 0.2); }
    .feedback-body textarea:focus { border-color: hsl(var(--emerald) 0.3); outline: none; }
    .feedback-send {
      width: 100%; padding: 10px; background: hsl(var(--emerald)); color: hsl(var(--background));
      border: none; border-radius: 4px; font-size: 13px; font-weight: 600;
      cursor: pointer; transition: background 0.15s;
    }
    .feedback-send:hover { background: hsl(152 60% 55%); }
    .feedback-send:disabled { opacity: 0.5; cursor: not-allowed; }
    .feedback-msg { text-align: center; font-size: 13px; padding: 8px 0; }
    .feedback-msg-ok { color: hsl(var(--emerald)); }
    .feedback-msg-err { color: hsl(0 84% 60%); }

    /* Status bar */
    .status-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      height: 32px;
      background: hsl(var(--emerald) 0.03);
      border-bottom: 1px solid hsl(var(--emerald) 0.08);
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      flex-shrink: 0;
    }
    .status-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: hsl(var(--emerald));
      box-shadow: 0 0 6px hsl(var(--emerald) 0.4);
      flex-shrink: 0;
    }
    .status-text {
      color: hsl(var(--foreground) / 0.35);
    }
    .status-right {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .status-link {
      color: hsl(var(--foreground) / 0.2);
      text-decoration: none;
      font-size: 10px;
      transition: color 0.15s;
    }
    .status-link:hover {
      color: hsl(var(--foreground) / 0.5);
    }
    @media (max-width: 767px) {
      .status-bar { padding: 0 16px; font-size: 10px; }
      .status-link { display: none; }
    }

    /* Main */
    main {
      flex: 1;
      min-width: 0;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 0;
    }
    .main-header {
      padding: 20px 32px;
      border-bottom: 1px solid hsl(var(--foreground) / 0.05);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      background: hsl(var(--background));
      z-index: 10;
    }
    .main-content { padding: 28px 32px; }

    /* ── Command Palette (⌘K) ── */
    #cmdk-overlay {
      position: fixed;
      inset: 0;
      background: hsl(var(--background) / 0.6);
      z-index: 1000;
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }
    #cmdk-modal {
      max-width: 580px;
      margin: 20vh auto 0;
      background: hsl(var(--background));
      border: 1px solid hsl(var(--foreground) / 0.1);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 24px 64px hsl(var(--background) / 0.6);
    }
    #cmdk-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
      border-bottom: 1px solid hsl(var(--foreground) / 0.06);
    }
    #cmdk-input {
      width: 100%;
      padding: 16px 60px 16px 20px;
      background: transparent;
      border: none;
      color: hsl(var(--foreground) / 0.9);
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      outline: none;
    }
    #cmdk-input:focus {
      outline: none;
    }
    #cmdk-input::placeholder { color: hsl(var(--foreground) / 0.2); }
    #cmdk-shortcut-badge {
      position: absolute;
      right: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: hsl(var(--foreground) / 0.2);
      background: hsl(var(--foreground) / 0.06);
      padding: 2px 6px;
      border-radius: 4px;
      pointer-events: none;
    }
    #cmdk-results {
      max-height: 400px;
      overflow-y: auto;
    }
    #cmdk-results:empty::after {
      content: 'Sin resultados';
      display: block;
      padding: 24px 20px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: hsl(var(--foreground) / 0.2);
      text-align: center;
    }
    .cmdk-category {
      padding: 8px 20px 4px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: hsl(var(--foreground) / 0.2);
    }
    .cmdk-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 20px;
      cursor: pointer;
      font-size: 13px;
      color: hsl(var(--foreground) / 0.65);
      border-left: 2px solid transparent;
      transition: background 0.1s;
    }
    .cmdk-item:hover { background: hsl(var(--foreground) / 0.04); }
    .cmdk-item.selected {
      background: hsl(var(--emerald) 0.1);
      border-left-color: hsl(var(--emerald));
      color: hsl(var(--foreground) / 0.9);
    }
    .cmdk-item .cmdk-icon { font-size: 12px; width: 18px; text-align: center; flex-shrink: 0; }
    .cmdk-item .cmdk-sub {
      margin-left: auto;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      color: hsl(var(--foreground) / 0.2);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 160px;
    }

    /* ── Mobile topbar ── */
    .mobile-topbar {
      display: none;
      position: sticky;
      top: 0;
      z-index: 50;
      height: 48px;
      background: hsl(var(--background));
      border-bottom: 1px solid hsl(var(--foreground) / 0.05);
      align-items: center;
      padding: 0 16px;
      gap: 12px;
      flex-shrink: 0;
    }
    #sidebar-toggle {
      background: none;
      border: 1px solid hsl(var(--foreground) / 0.1);
      color: hsl(var(--foreground) / 0.7);
      font-size: 16px;
      width: 36px;
      height: 36px;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    #sidebar-toggle:hover { background: hsl(var(--foreground) / 0.06); }
    .mobile-logo {
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      color: hsl(var(--foreground) / 0.9);
      text-decoration: none;
      letter-spacing: -0.5px;
    }
    .mobile-logo span { color: hsl(var(--emerald)); animation: blink 1.2s infinite; }
    .sidebar-backdrop {
      display: none;
      position: fixed;
      inset: 0;

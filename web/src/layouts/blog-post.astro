---
import '../styles/global.css';
import { Header } from '@/components/Header';
import { Footer } from '@/components/Footer';
import { CommandPalette } from '@/components/CommandPalette';
import { getCollection } from 'astro:content';

export interface Props {
  title: string;
  excerpt: string;
  date: Date;
  readTime: string;
  category: string;
  series: string;
  author: string;
  tags: string[];
  slug: string;
  url: string;
}

const { title, excerpt, date, readTime, category, series, author, tags, slug, url } = Astro.props;

const formattedDate = date.toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

// Related posts — the editorial collection is more useful than a broad category.
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter(p => p.data.series === series && p.id !== slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const canonicalUrl = `https://elicita.es/blog/${slug}`;
const ogUrl = canonicalUrl;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — elicita_</title>
    <meta name="description" content={excerpt} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Plausible Analytics -->
    <script defer data-domain="elicita.es" src="https://analytics.elicita.es/js/script.js"></script>
    <link rel="alternate" type="application/rss+xml" title="Blog elicita_" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={excerpt} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="elicita_" />
    <meta property="og:image" content="https://elicita.es/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="elicita_ · 63M+ registros oficiales de contratación pública — actualizado cada 4 horas" />
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:author" content={author} />
    <meta property="article:section" content={category} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={excerpt} />
    <meta name="twitter:image" content="https://elicita.es/og-image.png" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": excerpt,
      "datePublished": date.toISOString(),
      "author": { "@type": "Organization", "name": author },
      "publisher": {
        "@type": "Organization",
        "name": "elicita_",
        "url": "https://elicita.es"
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl }
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header client:load />
    <main>
      <article class="py-20 md:py-28">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto">

            <!-- Back link -->
            <a
              href="/blog"
              class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors mb-10 group"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
              </svg>
              Volver al blog
            </a>

            <!-- Article header -->
            <header class="mb-12">
              <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground mb-4">
                <span class="inline-flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  {formattedDate}
                </span>
                <span class="text-muted-foreground/40">·</span>
                <span class="inline-flex items-center gap-1.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {readTime}
                </span>
                <span class="text-muted-foreground/40">·</span>
                <span class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-emerald-500/10 text-emerald-400">
                  {series}
                </span>
              </div>
              <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-5">{title}</h1>
              <p class="text-xl text-muted-foreground leading-relaxed">{excerpt}</p>
            </header>

            <!-- MDX content -->
            <div class="prose prose-lg prose-headings:font-bold prose-headings:tracking-tight prose-a:text-emerald-600 dark:prose-a:text-emerald-400 prose-a:no-underline hover:prose-a:underline prose-code:text-emerald-700 dark:prose-code:text-emerald-300 prose-code:bg-black/5 dark:prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:before:content-none prose-code:after:content-none prose-pre:bg-black/5 dark:prose-pre:bg-white/5 prose-pre:border prose-pre:border-border max-w-none">
              <slot />
            </div>

            <!-- Author section -->
            <div class="mt-14 pt-8 border-t border-white/10">
              <div class="flex items-center gap-4">
                <div class="h-12 w-12 rounded-full bg-emerald-500/20 flex items-center justify-center flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-sm">{author}</p>
                  <p class="text-sm text-muted-foreground">Análisis e inteligencia sobre contratación pública española</p>
                </div>
              </div>
            </div>

            <!-- Social share -->
            <div class="mt-8 pt-8 border-t border-white/10">
              <p class="text-sm text-muted-foreground mb-4">Compartir</p>
              <div class="flex items-center gap-3">
                <a
                  href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonicalUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-white/10 hover:border-white/20 text-sm text-muted-foreground hover:text-foreground transition-all hover:bg-white/5"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  Twitter / X
                </a>
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalUrl)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-white/10 hover:border-white/20 text-sm text-muted-foreground hover:text-foreground transition-all hover:bg-white/5"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  LinkedIn
                </a>
                <button
                  id="copy-link-btn"
                  data-url={canonicalUrl}
                  class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-white/10 hover:border-white/20 text-sm text-muted-foreground hover:text-foreground transition-all hover:bg-white/5 cursor-pointer"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                  </svg>
                  <span id="copy-link-text">Copiar enlace</span>
                </button>
              </div>
            </div>

            <!-- CTA Banner -->
            <div class="mt-14 rounded-2xl border border-emerald-500/20 bg-emerald-500/5 p-8 text-center">
              <h3 class="text-2xl font-bold mb-2">Prueba Elicita gratis</h3>
              <p class="text-muted-foreground mb-6">Investiga mercados, compradores y competidores con evidencia de contratación pública.</p>
              <a
                href="/sign-up"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-emerald-500 text-black font-semibold hover:bg-emerald-400 transition-colors"
              >
                Empezar gratis
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

            <!-- Related posts -->
            {relatedPosts.length > 0 && (
              <div class="mt-16">
                <h2 class="text-xl font-bold mb-6">Artículos relacionados</h2>
                <div class="grid gap-4">
                  {relatedPosts.map(post => (
                    <a
                      href={`/blog/${post.id}`}
                      class="group flex items-start gap-4 p-5 rounded-xl border border-white/10 hover:border-emerald-500/30 hover:bg-white/[0.02] transition-all"
                    >
                      <div class="flex-1 min-w-0">
                        <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full bg-emerald-500/10 text-emerald-400 mb-2">
                          {post.data.series}
                        </span>
                        <h3 class="font-semibold group-hover:text-emerald-400 transition-colors line-clamp-2">
                          {post.data.title}
                        </h3>
                        <p class="text-sm text-muted-foreground mt-1 line-clamp-2">{post.data.excerpt}</p>
                      </div>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted-foreground mt-1 flex-shrink-0 group-hover:text-emerald-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            )}

          </div>
        </div>
      </article>
    </main>
    <Footer />
    <CommandPalette client:only="react" />

    <script>
      const btn = document.getElementById('copy-link-btn');
      const txt = document.getElementById('copy-link-text');
      if (btn && txt) {
        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-url') || window.location.href;
          await navigator.clipboard.writeText(url);
          txt.textContent = '¡Enlace copiado!';
          setTimeout(() => { txt.textContent = 'Copiar enlace'; }, 2000);
        });
      }
    </script>
  </body>
</html>

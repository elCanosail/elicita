---
import { Check, Minus } from 'lucide-react';
import { PRICING_PLANS, formatPrice } from '@/lib/pricing';

interface Props {
  variant?: 'home' | 'page';
}

const { variant = 'page' } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto">
  {PRICING_PLANS.map((plan) => {
    const cta = plan.ctas[variant];
    const isPro = plan.id === 'pro';
    return (
      <div
        class={`relative rounded-xl p-8 space-y-6 ${
          isPro
            ? 'border border-emerald-500/30 bg-emerald-500/[0.02]'
            : 'border border-white/7 bg-white/[0.01]'
        }`}
      >
        {plan.badge && (
          <div class="absolute -top-3 left-6 bg-emerald-500 text-black font-mono text-[10px] tracking-wider uppercase px-3 py-1 rounded">
            {plan.badge}
          </div>
        )}

        <div>
          <p class={`font-mono text-sm mb-2 ${isPro ? 'text-emerald-400/70' : 'text-white/50'}`}>
            {plan.name}
          </p>
          <p class="text-3xl text-white font-light">
            €{formatPrice(plan.priceMonthly)}
            {plan.priceMonthly > 0 && <span class="text-white/30 text-base">/mes</span>}
          </p>
          {plan.priceAnnual > 0 ? (
            <p class="text-white/20 text-xs font-mono mt-1">
              o €{formatPrice(plan.priceAnnual)}/año (2 meses gratis)
            </p>
          ) : (
            <p class="text-white/20 text-xs font-mono mt-1">para siempre</p>
          )}
        </div>

        <p class="text-white/35 text-sm leading-relaxed">{plan.description}</p>

        <div class="space-y-2.5">
          {plan.features.map((feature) => (
            <div class="flex items-start gap-3 font-mono text-xs text-white/40">
              {feature.included ? (
                <Check className="h-4 w-4 text-emerald-400 shrink-0 mt-0.5" />
              ) : (
                <Minus className="h-4 w-4 text-white/20 shrink-0 mt-0.5" />
              )}
              <span class={feature.included ? '' : 'text-white/25'}>{feature.text}</span>
            </div>
          ))}
        </div>

        <a
          href={cta.href}
          class={`block text-center font-mono text-sm px-6 py-3 rounded transition-colors ${
            cta.primary
              ? 'bg-emerald-500 hover:bg-emerald-600 text-black font-medium'
              : 'border border-white/10 hover:border-white/20 text-white/50 hover:text-white/70'
          }`}
        >
          {cta.label}
        </a>
      </div>
    );
  })}
</div>
